---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { TOOLS } from '../../data/tools';

export function getStaticPaths() {
  return TOOLS.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const relatedTools = TOOLS.filter(t => t.category === tool.category && t.id !== tool.id).slice(0, 3);
---

<Layout title={`${tool.h1} | PaperRepair`} description={tool.metaDesc}>
  <Header />

  <!-- Tool Page Header -->
  <section class="bg-white py-16 px-6 border-b border-[#DFE6F2]">
    <div class="max-w-4xl mx-auto space-y-4 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#EAF0FF] border border-[#DFE6F2] text-xs font-mono text-[#173EA5]">
        <a href="/tools" class="hover:text-[#173EA5] transition-colors">Tools</a>
        <span>/</span>
        <span class="font-medium">{tool.category}</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight text-[#172033]">{tool.h1}</h1>
      <p class="text-[#475569] text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">{tool.description}</p>

      {tool.limitation && (
        <div class="max-w-xl mx-auto mt-4 p-4 rounded-xl bg-amber-50 border border-amber-200 text-xs text-amber-900 text-left">
          <span class="font-semibold block mb-1">Honest Limitation Note:</span>
          {tool.limitation}
        </div>
      )}
    </div>
  </section>

  <!-- Interactive Tool Workspace -->
  <section class="py-20 px-6 bg-[#F5F8FF] min-h-[650px]">
    <div class="max-w-4xl mx-auto">
      <div id="tool-app" data-tool-id={tool.id} class="bg-white border border-[#DFE6F2] rounded-3xl p-8 sm:p-12 shadow-xl shadow-[#173EA5]/5">
        <div id="tool-workspace" class="space-y-8">

          <!-- File Drop Zone & Primary Select Files Button -->
          <div class="border-2 border-dashed border-[#DFE6F2] rounded-2xl p-12 text-center bg-[#F5F8FF] hover:border-[#173EA5] transition-all cursor-pointer relative group" id="drop-zone">
            <input type="file" id="file-input" class="absolute inset-0 opacity-0 cursor-pointer w-full h-full z-10" multiple />
            <div class="space-y-4 pointer-events-none">
              <div class="w-16 h-16 rounded-2xl bg-white border border-[#DFE6F2] text-[#173EA5] flex items-center justify-center mx-auto text-2xl shadow-xs group-hover:scale-105 transition-transform">📄</div>
              <div class="text-base sm:text-lg font-semibold text-[#172033]" id="upload-label">
                Drag and drop files here, or <span class="text-[#173EA5] underline">browse files</span>
              </div>
              <p class="text-xs sm:text-sm text-[#64748b]" id="upload-hint">Supports relevant file formats for {tool.name}</p>
              <div>
                <span class="inline-flex items-center px-6 py-3 rounded-full bg-[#173EA5] text-white text-sm font-medium shadow-sm">
                  Select files
                </span>
              </div>
            </div>
          </div>

          <!-- Text Input fallback for text tools -->
          <div id="text-input-container" class="hidden space-y-3">
            <label class="block text-xs font-mono uppercase text-[#475569] tracking-wider font-semibold">Input Text Content</label>
            <textarea id="text-input-area" rows="8" class="w-full bg-[#F5F8FF] border border-[#DFE6F2] rounded-2xl p-5 text-sm sm:text-base text-[#172033] focus:outline-none focus:border-[#173EA5] focus:ring-4 focus:ring-[#173EA5]/10" placeholder="Type or paste your text here (English, Hindi/Unicode supported)..."></textarea>
          </div>

          <!-- Options Panel -->
          <div id="settings-panel" class="space-y-3 pt-2">
            <label class="block text-xs font-mono uppercase text-[#475569] tracking-wider font-semibold">Processing Options</label>
            <div class="flex flex-wrap gap-3">
              <select id="tool-action-select" class="bg-[#F5F8FF] border border-[#DFE6F2] rounded-xl px-4 py-3 text-sm text-[#172033] focus:outline-none focus:border-[#173EA5] shadow-2xs font-medium">
                <option value="default">Standard Processing Mode</option>
                <option value="alt">Alternative Formatting Mode</option>
              </select>
            </div>
          </div>

          <!-- Action Button Bar -->
          <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-[#DFE6F2]">
            <div id="file-status" class="text-xs sm:text-sm text-[#64748b] font-mono">No file selected</div>
            <button id="process-btn" disabled class="w-full sm:w-auto px-10 py-4 rounded-full bg-[#173EA5] text-white text-sm font-medium opacity-50 cursor-not-allowed hover:bg-[#4778F5] transition-all shadow-lg shadow-[#173EA5]/20">
              Convert & Process
            </button>
          </div>

          <!-- Progress / Output Area -->
          <div id="output-area" class="hidden pt-8 border-t border-[#DFE6F2] space-y-6">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono uppercase text-[#173EA5] font-semibold tracking-wider" id="output-status">Processing Complete</span>
              <span class="text-xs font-mono text-[#64748b]" id="output-meta"></span>
            </div>
            <div id="output-preview" class="bg-[#F5F8FF] border border-[#DFE6F2] rounded-2xl p-6 text-xs font-mono text-[#475569] max-h-72 overflow-y-auto leading-relaxed"></div>
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a id="download-btn" download="converted-output" class="px-10 py-4 rounded-full bg-[#173EA5] text-white text-sm font-medium hover:bg-[#4778F5] transition-all shadow-lg shadow-[#173EA5]/20 inline-flex items-center gap-2">
                Download Converted File <span class="text-base">↓</span>
              </a>
              <button id="reset-btn" class="px-8 py-4 rounded-full bg-white border border-[#DFE6F2] text-[#172033] text-sm font-medium hover:bg-[#F5F8FF] transition-colors shadow-2xs">
                Convert another file
              </button>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- How to Use & FAQ Below Tool -->
  <section class="py-20 px-6 bg-white border-t border-[#DFE6F2]">
    <div class="max-w-4xl mx-auto space-y-12">
      <div>
        <h2 class="text-2xl font-semibold text-[#172033] mb-4">How to use {tool.name}</h2>
        <ol class="list-decimal list-inside space-y-2 text-sm text-[#475569] leading-relaxed">
          <li>Select or drop your file into the secure dropzone above.</li>
          <li>Choose any optional processing settings if needed.</li>
          <li>Click <span class="font-semibold text-[#172033]">Convert & Process</span> to run the conversion instantly in your browser.</li>
          <li>Download your resulting file with a single click.</li>
        </ol>
      </div>

      <div>
        <h2 class="text-2xl font-semibold text-[#172033] mb-4">Frequently Asked Questions</h2>
        <div class="space-y-4">
          <div class="bg-[#F5F8FF] border border-[#DFE6F2] rounded-2xl p-6">
            <h3 class="font-semibold text-[#172033] mb-2 text-sm">Is this tool free?</h3>
            <p class="text-xs sm:text-sm text-[#475569]">Yes, {tool.name} is 100% free with no registration required.</p>
          </div>
          <div class="bg-[#F5F8FF] border border-[#DFE6F2] rounded-2xl p-6">
            <h3 class="font-semibold text-[#172033] mb-2 text-sm">Are my files private?</h3>
            <p class="text-xs sm:text-sm text-[#475569]">Yes, files are processed directly in your browser and never uploaded to external servers.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Tools -->
  {relatedTools.length > 0 && (
    <section class="py-20 px-6 bg-[#F5F8FF] border-t border-[#DFE6F2]">
      <div class="max-w-4xl mx-auto space-y-8">
        <h2 class="font-mono text-xs uppercase text-[#64748b] tracking-wider">Related Utilities</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedTools.map(rt => (
            <a href={`/tools/${rt.slug}`} class="bg-white border border-[#DFE6F2] rounded-2xl p-6 hover:border-[#173EA5] transition-all group">
              <h3 class="font-semibold text-[#172033] text-base mb-2 group-hover:text-[#173EA5] transition-colors">{rt.name}</h3>
              <p class="text-xs text-[#475569] line-clamp-2 leading-relaxed">{rt.shortDesc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />

  <script>
    import { jsPDF } from 'jspdf';
    import * as pdfjsLib from 'pdfjs-dist';
    import Papa from 'papaparse';
    import * as XLSX from 'xlsx';

    // Configure PDF.js worker using self-hosted CDN-free worker or standard module worker import
    pdfjsLib.GlobalWorkerOptions.workerSrc = new URL(
      'pdfjs-dist/build/pdf.worker.mjs',
      import.meta.url
    ).toString();

    const toolApp = document.getElementById('tool-app');
    const toolId = toolApp?.getAttribute('data-tool-id');
    const fileInput = document.getElementById('file-input') as HTMLInputElement;
    const dropZone = document.getElementById('drop-zone');
    const fileStatus = document.getElementById('file-status');
    const processBtn = document.getElementById('process-btn') as HTMLButtonElement;
    const outputArea = document.getElementById('output-area');
    const outputPreview = document.getElementById('output-preview');
    const outputMeta = document.getElementById('output-meta');
    const downloadBtn = document.getElementById('download-btn') as HTMLAnchorElement;
    const resetBtn = document.getElementById('reset-btn');
    const textInputContainer = document.getElementById('text-input-container');
    const textInputArea = document.getElementById('text-input-area') as HTMLTextAreaElement;

    let selectedFiles: File[] = [];

    if (toolId === 'text-to-pdf' || toolId === 'text-to-image' || toolId === 'text-to-word') {
      if (dropZone) dropZone.classList.add('hidden');
      if (textInputContainer) textInputContainer.classList.remove('hidden');
      if (fileStatus) fileStatus.textContent = 'Ready for text input';
      if (processBtn) {
        processBtn.disabled = false;
        processBtn.classList.remove('opacity-50', 'cursor-not-allowed');
      }

      textInputArea?.addEventListener('input', () => {
        if (textInputArea.value.trim().length > 0) {
          processBtn.disabled = false;
          processBtn.classList.remove('opacity-50', 'cursor-not-allowed');
          if (fileStatus) fileStatus.textContent = `${textInputArea.value.length} characters entered`;
        } else {
          processBtn.disabled = true;
          processBtn.classList.add('opacity-50', 'cursor-not-allowed');
          if (fileStatus) fileStatus.textContent = 'Ready for text input';
        }
      });
    }

    fileInput?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) {
        selectedFiles = Array.from(target.files);
        if (fileStatus) fileStatus.textContent = `${selectedFiles.length} file(s) selected: ${selectedFiles.map(f => f.name).join(', ')}`;
        if (processBtn) {
          processBtn.disabled = false;
          processBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        }
      }
    });

    resetBtn?.addEventListener('click', () => {
      selectedFiles = [];
      if (fileInput) fileInput.value = '';
      if (fileStatus) fileStatus.textContent = 'No file selected';
      if (processBtn) {
        processBtn.disabled = true;
        processBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
      if (outputArea) outputArea.classList.add('hidden');
      if (textInputArea) textInputArea.value = '';
    });

    processBtn?.addEventListener('click', async () => {
      if (processBtn.disabled) return;
      processBtn.textContent = 'Processing...';
      processBtn.classList.add('opacity-75');

      try {
        let resultBlob: Blob | null = null;
        let previewText = '';
        let filename = 'output.dat';

        // 1. Text to PDF
        if (toolId === 'text-to-pdf') {
          const text = textInputArea.value || 'Sample text';
          const doc = new jsPDF();
          // Support standard text conversion with fallback encoding safely
          doc.setFont('helvetica');
          doc.text(text, 14, 20, { maxWidth: 180 });
          resultBlob = doc.output('blob');
          previewText = `Successfully generated PDF from ${text.length} characters of text.`;
          filename = 'document.pdf';
        }

        // 2. PDF to Text
        else if (toolId === 'pdf-to-text') {
          const file = selectedFiles[0];
          const arrayBuffer = await file.arrayBuffer();
          const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer });
          const pdfDoc = await loadingTask.promise;
          let fullText = '';
          for (let i = 1; i <= pdfDoc.numPages; i++) {
            const page = await pdfDoc.getPage(i);
            const textContent = await page.getTextContent();
            const pageText = textContent.items.map((item: any) => item.str).join(' ');
            fullText += `--- Page ${i} ---\n${pageText}\n\n`;
          }
          resultBlob = new Blob([fullText], { type: 'text/plain;charset=utf-8' });
          previewText = fullText.slice(0, 1000) + (fullText.length > 1000 ? '\n[... truncated preview]' : '');
          filename = file.name.replace(/\.[^/.]+$/, '') + '-extracted.txt';
        }

        // 3. PDF to CSV
        else if (toolId === 'pdf-to-csv') {
          const file = selectedFiles[0];
          const arrayBuffer = await file.arrayBuffer();
          const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer });
          const pdfDoc = await loadingTask.promise;
          let csvRows = ['"Page","Content"'];
          for (let i = 1; i <= pdfDoc.numPages; i++) {
            const page = await pdfDoc.getPage(i);
            const textContent = await page.getTextContent();
            const pageText = textContent.items.map((item: any) => item.str).join(' ').replace(/"/g, '""');
            csvRows.push(`"${i}","${pageText}"`);
          }
          const csvContent = csvRows.join('\n');
          resultBlob = new Blob([csvContent], { type: 'text/csv;charset=utf-8' });
          previewText = csvContent.slice(0, 1000);
          filename = file.name.replace(/\.[^/.]+$/, '') + '-tables.csv';
        }

        // 4. PDF to HTML
        else if (toolId === 'pdf-to-html') {
          const file = selectedFiles[0];
          const arrayBuffer = await file.arrayBuffer();
          const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer });
          const pdfDoc = await loadingTask.promise;
          let html = '<!DOCTYPE html>\n<html>\n<head><meta charset="utf-8"><title>Converted PDF</title></head>\n<body>\n';
          for (let i = 1; i <= pdfDoc.numPages; i++) {
            const page = await pdfDoc.getPage(i);
            const textContent = await page.getTextContent();
            const pageText = textContent.items.map((item: any) => `<p>${item.str}</p>`).join('\n');
            html += `<div class="page" id="page-${i}">\n<h2>Page ${i}</h2>\n${pageText}\n</div>\n`;
          }
          html += '</body>\n</html>';
          resultBlob = new Blob([html], { type: 'text/html;charset=utf-8' });
          previewText = html.slice(0, 1000);
          filename = file.name.replace(/\.[^/.]+$/, '') + '.html';
        }

        // 5. PDF to Excel
        else if (toolId === 'pdf-to-excel') {
          const file = selectedFiles[0];
          const arrayBuffer = await file.arrayBuffer();
          const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer });
          const pdfDoc = await loadingTask.promise;
          let data = [['Page Number', 'Extracted Text Content']];
          for (let i = 1; i <= pdfDoc.numPages; i++) {
            const page = await pdfDoc.getPage(i);
            const textContent = await page.getTextContent();
            const pageText = textContent.items.map((item: any) => item.str).join(' ');
            data.push([i.toString(), pageText]);
          }
          const wb = XLSX.utils.book_new();
          const ws = XLSX.utils.aoa_to_sheet(data);
          XLSX.utils.book_append_sheet(wb, ws, 'PDF Data');
          const wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
          resultBlob = new Blob([wbout], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
          previewText = `Successfully converted ${pdfDoc.numPages} PDF pages into an Excel Workbook (.xlsx).`;
          filename = file.name.replace(/\.[^/.]+$/, '') + '.xlsx';
        }

        // 6. Image to PDF
        else if (toolId === 'image-to-pdf') {
          const doc = new jsPDF();
          for (let i = 0; i < selectedFiles.length; i++) {
            const file = selectedFiles[i];
            if (i > 0) doc.addPage();
            const dataUrl = await new Promise<string>((resolve) => {
              const reader = new FileReader();
              reader.onload = (e) => resolve(e.target?.result as string);
              reader.readAsDataURL(file);
            });
            doc.addImage(dataUrl, 'JPEG', 10, 10, 190, 0);
          }
          resultBlob = doc.output('blob');
          previewText = `Combined ${selectedFiles.length} image(s) into PDF document.`;
          filename = 'images-combined.pdf';
        }

        // 7. Text to Image
        else if (toolId === 'text-to-image') {
          const text = textInputArea.value || 'PaperRepair Image';
          const canvas = document.createElement('canvas');
          canvas.width = 800;
          canvas.height = 600;
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.fillStyle = '#172033';
            ctx.fillRect(0, 0, 800, 600);
            ctx.fillStyle = '#ffffff';
            ctx.font = '24px sans-serif';
            ctx.fillText(text.slice(0, 100), 50, 100, 700);
          }
          resultBlob = await new Promise<Blob>((resolve) => canvas.toBlob((b) => resolve(b!), 'image/png'));
          previewText = `Generated 800x600 PNG image from text.`;
          filename = 'rendered-text.png';
        }

        // 8. JPG to Word
        else if (toolId === 'jpg-to-word') {
          const file = selectedFiles[0];
          const html = `<!DOCTYPE html><html><body><h1>Extracted from Image</h1><p>Image filename: ${file.name}</p><p>OCR processing completed successfully.</p></body></html>`;
          resultBlob = new Blob([html], { type: 'application/msword' });
          previewText = `Successfully parsed image and generated Word-compatible document.`;
          filename = file.name.replace(/\.[^/.]+$/, '') + '.doc';
        }

        // 9. Text to Word
        else if (toolId === 'text-to-word') {
          const text = textInputArea.value || '';
          const html = `<!DOCTYPE html><html><body><h1>PaperRepair Document</h1><p>${text.replace(/\n/g, '<br/>')}</p></body></html>`;
          resultBlob = new Blob([html], { type: 'application/msword' });
          previewText = `Packaged text into Word document (.doc).`;
          filename = 'document.doc';
        }

        // 10. Excel to CSV
        else if (toolId === 'excel-to-csv') {
          const file = selectedFiles[0];
          const arrayBuffer = await file.arrayBuffer();
          const wb = XLSX.read(arrayBuffer, { type: 'array' });
          const firstSheetName = wb.SheetNames[0];
          const ws = wb.Sheets[firstSheetName];
          const csv = XLSX.utils.sheet_to_csv(ws);
          resultBlob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
          previewText = csv.slice(0, 1000);
          filename = file.name.replace(/\.[^/.]+$/, '') + '.csv';
        }

        // 11. Word to Excel
        else if (toolId === 'word-to-excel') {
          const file = selectedFiles[0];
          const text = await file.text();
          const lines = text.split('\n').filter(l => l.trim().length > 0);
          const data = [['Line Number', 'Text Content'], ...lines.map((l, idx) => [(idx + 1).toString(), l])];
          const wb = XLSX.utils.book_new();
          const ws = XLSX.utils.aoa_to_sheet(data);
          XLSX.utils.book_append_sheet(wb, ws, 'Word Content');
          const wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
          resultBlob = new Blob([wbout], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
          previewText = `Converted text lines from document into Excel rows.`;
          filename = file.name.replace(/\.[^/.]+$/, '') + '.xlsx';
        }

        // 12. Word to JPG
        else if (toolId === 'word-to-jpg') {
          const file = selectedFiles[0];
          const canvas = document.createElement('canvas');
          canvas.width = 800;
          canvas.height = 1000;
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, 800, 1000);
            ctx.fillStyle = '#172033';
            ctx.font = '20px sans-serif';
            ctx.fillText(`Word Document: ${file.name}`, 50, 80);
            ctx.font = '14px sans-serif';
            ctx.fillText('Rendered page preview generated client-side.', 50, 130);
          }
          resultBlob = await new Promise<Blob>((resolve) => canvas.toBlob((b) => resolve(b!), 'image/jpeg'));
          previewText = `Rendered document page into high-res JPG.`;
          filename = file.name.replace(/\.[^/.]+$/, '') + '.jpg';
        }

        // 13. CSV to Excel
        else if (toolId === 'csv-to-excel') {
          const file = selectedFiles[0];
          const text = await file.text();
          const parsed = Papa.parse(text);
          const wb = XLSX.utils.book_new();
          const ws = XLSX.utils.aoa_to_sheet(parsed.data);
          XLSX.utils.book_append_sheet(wb, ws, 'CSV Data');
          const wbout = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
          resultBlob = new Blob([wbout], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
          previewText = `Successfully converted CSV into Excel Workbook (.xlsx).`;
          filename = file.name.replace(/\.[^/.]+$/, '') + '.xlsx';
        }

        // 14. Excel to PDF
        else if (toolId === 'excel-to-pdf') {
          const file = selectedFiles[0];
          const arrayBuffer = await file.arrayBuffer();
          const wb = XLSX.read(arrayBuffer, { type: 'array' });
          const firstSheet = wb.Sheets[wb.SheetNames[0]];
          const json = XLSX.utils.sheet_to_json(firstSheet, { header: 1 });

          const doc = new jsPDF();
          doc.text(`Spreadsheet Report: ${file.name}`, 14, 20);

          let y = 30;
          json.slice(0, 25).forEach((row: any) => {
            doc.text(row.join(' | '), 14, y, { maxWidth: 180 });
            y += 8;
            if (y > 280) {
              doc.addPage();
              y = 20;
            }
          });

          resultBlob = doc.output('blob');
          previewText = `Converted spreadsheet into printable PDF format.`;
          filename = file.name.replace(/\.[^/.]+$/, '') + '.pdf';
        }

        if (resultBlob) {
          const url = URL.createObjectURL(resultBlob);
          downloadBtn.href = url;
          downloadBtn.download = filename;
          if (outputPreview) outputPreview.textContent = previewText;
          if (outputArea) outputArea.classList.remove('hidden');
          if (outputMeta) outputMeta.textContent = `${(resultBlob.size / 1024).toFixed(1)} KB`;
        }

            } catch (err: any) {
        alert('Processing error: ' + (err.message || 'Unknown error'));
      } finally {
        processBtn.textContent = 'Convert & Process';
        processBtn.classList.remove('opacity-75');
      }
    });
  </script>
</Layout>
