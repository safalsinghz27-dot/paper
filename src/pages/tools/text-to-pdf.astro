---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { TOOLS } from '../../data/tools';

const tool = TOOLS.find(t => t.slug === 'text-to-pdf') || TOOLS[0];
const relatedTools = TOOLS.filter(t => t.category === tool.category && t.id !== tool.id).slice(0, 3);
---

<Layout title={`${tool.h1} | PaperRepair Pro`} description={tool.metaDesc}>
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DejaVu+Sans:ital,wght@0,400;0,700;1,400&family=Gelasio:ital,wght@0,400;0,600;1,400&family=Liberation+Mono:ital,wght@0,400;0,700;1,400&family=Liberation+Sans:ital,wght@0,400;0,700;1,400&family=Liberation+Serif:ital,wght@0,400;0,700;1,400&family=Noto+Sans+Devanagari:wght@400;600;700&display=swap" rel="stylesheet">
  </head>
  <Header />

  <!-- Breadcrumb -->
  <div class="bg-[#F5F8FF] border-b border-[#DFE6F2] py-3 px-6">
    <div class="max-w-7xl mx-auto flex items-center gap-2 text-xs font-mono text-[#173EA5]">
      <a href="/tools" class="hover:text-[#173EA5] transition-colors">Tools</a>
      <span>/</span>
      <span>{tool.category}</span>
      <span>/</span>
      <span class="text-[#475569]">Text to PDF</span>
    </div>
  </div>

  <!-- Main Tool Area (Competitor Layout Inspired) -->
  <section class="py-8 px-4 sm:px-6 bg-[#F5F8FF] min-h-[800px]">
    <div class="max-w-5xl mx-auto space-y-6">

      <!-- (1) Existing H1 centered as the title -->
      <div class="text-center space-y-2">
        <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight text-[#172033]">{tool.h1}</h1>
        <p class="text-sm text-[#475569]">Turn text or documents into professional PDF documents instantly in your browser.</p>
      </div>

      <!-- Tool Card Container -->
      <div class="bg-white border border-[#DFE6F2] rounded-3xl shadow-xl shadow-[#173EA5]/5 overflow-hidden flex flex-col">

        <!-- (2) Formatting Toolbar Row across full width -->
        <div id="toolbar-container" class="bg-[#F8FAFC] border-b border-[#DFE6F2] px-4 py-2.5 flex items-center gap-1.5 overflow-x-auto scrollbar-none text-[#172033] text-xs flex-wrap select-none relative z-10">

          <!-- Document / Page Menu Dropdown -->
          <div class="relative group">
            <button type="button" id="menu-page-btn" class="px-3 py-1.5 rounded-xl bg-white border border-[#DFE6F2] hover:border-[#173EA5] font-medium flex items-center gap-1 shadow-2xs">
              <span>📄 Page Options</span>
              <span class="text-[10px]">▼</span>
            </button>
            <div id="menu-page-dropdown" class="hidden absolute left-0 mt-1 w-64 bg-white border border-[#DFE6F2] rounded-2xl shadow-xl p-4 space-y-3 z-50 text-xs">
              <div class="space-y-1">
                <label class="font-mono uppercase text-[#64748b] font-semibold text-[10px]">Page Size</label>
                <select id="opt-pagesize" class="w-full bg-[#F5F8FF] border border-[#DFE6F2] rounded-xl px-2.5 py-2 text-xs text-[#172033]">
                  <option value="pageless">Pageless (Continuous)</option>
                  <option value="a4" selected>A4 (210 × 297 mm)</option>
                  <option value="letter">Letter (8.5 × 11 in)</option>
                  <option value="legal">Legal (8.5 × 14 in)</option>
                  <option value="tabloid">Tabloid (11 × 17 in)</option>
                  <option value="a3">A3 (297 × 420 mm)</option>
                  <option value="a5">A5 (148 × 210 mm)</option>
                  <option value="b4">B4 (250 × 353 mm)</option>
                  <option value="b5">B5 (176 × 250 mm)</option>
                  <option value="statement">Statement (5.5 × 8.5 in)</option>
                  <option value="executive">Executive (7.25 × 10.5 in)</option>
                  <option value="folio">Folio (8.5 × 13 in)</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class="font-mono uppercase text-[#64748b] font-semibold text-[10px]">Orientation</label>
                <select id="opt-orientation" class="w-full bg-[#F5F8FF] border border-[#DFE6F2] rounded-xl px-2.5 py-2 text-xs text-[#172033]">
                  <option value="portrait" selected>Portrait</option>
                  <option value="landscape">Landscape</option>
                </select>
              </div>
              <div class="space-y-1">
                <label class="font-mono uppercase text-[#64748b] font-semibold text-[10px]">Margins</label>
                <select id="opt-margin" class="w-full bg-[#F5F8FF] border border-[#DFE6F2] rounded-xl px-2.5 py-2 text-xs text-[#172033]">
                  <option value="10">Narrow (10 mm)</option>
                  <option value="20" selected>Normal (20 mm)</option>
                  <option value="30">Wide (30 mm)</option>
                </select>
              </div>
              <div class="space-y-1 pt-2 border-t border-[#DFE6F2]">
                <label class="font-mono uppercase text-[#64748b] font-semibold text-[10px]">File Name</label>
                <input type="text" id="opt-filename" value="paperepair-document.pdf" class="w-full bg-[#F5F8FF] border border-[#DFE6F2] rounded-xl px-2.5 py-2 text-xs text-[#172033]" />
              </div>
            </div>
          </div>

          <span class="w-px h-5 bg-[#DFE6F2] mx-1"></span>

          <!-- Undo / Redo -->
          <button type="button" id="tb-undo" title="Undo (Ctrl+Z)" class="p-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5] transition-colors disabled:opacity-40">↺</button>
          <button type="button" id="tb-redo" title="Redo (Ctrl+Y)" class="p-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5] transition-colors disabled:opacity-40">↻</button>

          <span class="w-px h-5 bg-[#DFE6F2] mx-1"></span>

          <!-- Font Family Dropdown -->
          <select id="tb-font" title="Font Family" class="bg-white border border-[#DFE6F2] rounded-xl px-2.5 py-1.5 text-xs text-[#172033] hover:border-[#173EA5] focus:outline-none">
            <option value="Liberation Sans">Arial-style (Liberation Sans)</option>
            <option value="Liberation Mono">Courier-style (Liberation Mono)</option>
            <option value="Gelasio">Georgia-style (Gelasio)</option>
            <option value="Liberation Serif">Times-style (Liberation Serif)</option>
            <option value="DejaVu Sans" selected>Trebuchet-style / Verdana (DejaVu Sans)</option>
          </select>

          <!-- Text Style Dropdown -->
          <select id="tb-style" title="Text Style" class="bg-white border border-[#DFE6F2] rounded-xl px-2.5 py-1.5 text-xs text-[#172033] hover:border-[#173EA5] focus:outline-none">
            <option value="p" selected>Normal Text</option>
            <option value="h1">Heading 1</option>
            <option value="h2">Heading 2</option>
            <option value="h3">Heading 3</option>
          </select>

          <span class="w-px h-5 bg-[#DFE6F2] mx-1"></span>

          <!-- Font Size Controls (- num +) -->
          <div class="flex items-center bg-white border border-[#DFE6F2] rounded-xl overflow-hidden">
            <button type="button" id="tb-fontsize-dec" class="px-2 py-1.5 hover:bg-[#F5F8FF] font-bold text-xs">-</button>
            <input type="number" id="tb-fontsize-input" value="16" min="8" max="72" class="w-10 text-center text-xs py-1.5 focus:outline-none bg-transparent" title="Font Size (px)" />
            <button type="button" id="tb-fontsize-inc" class="px-2 py-1.5 hover:bg-[#F5F8FF] font-bold text-xs">+</button>
          </div>

          <span class="w-px h-5 bg-[#DFE6F2] mx-1"></span>

          <!-- Bold, Italic, Underline, Strikethrough -->
          <button type="button" id="tb-bold" title="Bold (Ctrl+B)" class="p-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5] font-bold text-xs transition-colors">B</button>
          <button type="button" id="tb-italic" title="Italic (Ctrl+I)" class="p-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5] italic text-xs transition-colors">I</button>
          <button type="button" id="tb-underline" title="Underline (Ctrl+U)" class="p-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5] underline text-xs transition-colors">U</button>
          <button type="button" id="tb-strike" title="Strikethrough" class="p-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5] line-through text-xs transition-colors">S</button>
          <button type="button" id="tb-code" title="Inline Code" class="px-2 py-1.5 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5] font-mono text-xs transition-colors">&lt;&gt;</button>

          <span class="w-px h-5 bg-[#DFE6F2] mx-1"></span>

          <!-- Colors & Highlight -->
          <div class="flex items-center gap-1">
            <label title="Text Color" class="flex items-center gap-1 cursor-pointer px-2 py-1 rounded-xl hover:bg-[#F5F8FF]">
              <span class="font-bold text-[11px] text-[#173EA5]">A</span>
              <input type="color" id="tb-color" value="#172033" class="w-4 h-4 rounded cursor-pointer border-0 bg-transparent" />
            </label>
            <label title="Highlight Color" class="flex items-center gap-1 cursor-pointer px-2 py-1 rounded-xl hover:bg-[#F5F8FF]">
              <span class="bg-yellow-200 px-1 rounded text-[10px]">HI</span>
              <input type="color" id="tb-highlight" value="#fef08a" class="w-4 h-4 rounded cursor-pointer border-0 bg-transparent" />
            </label>
          </div>

          <span class="w-px h-5 bg-[#DFE6F2] mx-1"></span>

          <!-- Alignment Menu -->
          <select id="tb-align" title="Text Alignment" class="bg-white border border-[#DFE6F2] rounded-xl px-2 py-1.5 text-xs text-[#172033] hover:border-[#173EA5] focus:outline-none">
            <option value="left" selected>Align Left</option>
            <option value="center">Align Center</option>
            <option value="right">Align Right</option>
            <option value="justify">Justify</option>
          </select>

          <!-- Insert Menu -->
          <div class="relative group">
            <button type="button" id="menu-insert-btn" class="px-2.5 py-1.5 rounded-xl bg-white border border-[#DFE6F2] hover:border-[#173EA5] font-medium flex items-center gap-1">
              <span>➕ Insert</span>
            </button>
            <div id="menu-insert-dropdown" class="hidden absolute left-0 mt-1 w-48 bg-white border border-[#DFE6F2] rounded-2xl shadow-xl p-2 space-y-1 z-50 text-xs">
              <button type="button" id="ins-hr" class="w-full text-left px-3 py-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5]">Horizontal Rule</button>
              <button type="button" id="ins-pagebreak" class="w-full text-left px-3 py-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5]">Page Break</button>
              <button type="button" id="ins-image" class="w-full text-left px-3 py-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5]">Image...</button>
              <button type="button" id="ins-table" class="w-full text-left px-3 py-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5]">Table (3×3)</button>
              <button type="button" id="ins-date" class="w-full text-left px-3 py-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5]">Current Date</button>
              <button type="button" id="ins-link" class="w-full text-left px-3 py-2 rounded-xl hover:bg-[#F5F8FF] hover:text-[#173EA5]">Insert Link...</button>
            </div>
          </div>

        </div>

        <!-- (3) Large, tall writing area (min-height ~60vh) -->
        <div class="relative flex-1 p-6 sm:p-8 bg-white">
          <div
            id="editor"
            class="w-full min-h-[60vh] max-h-[75vh] overflow-y-auto focus:outline-none text-[#172033] leading-relaxed font-normal text-base relative"
          ></div>

          <!-- (4) Rounded "+ Sample Document" pill inside writing area under placeholder, shown only while empty -->
          <div id="sample-pill-container" class="absolute top-12 left-8 pointer-events-none hidden">
            <button type="button" id="sample-pill-btn" class="pointer-events-auto inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-[#173EA5] text-white text-xs font-medium shadow-md hover:bg-[#4778F5] transition-all">
              <span>+ Sample Document</span>
            </button>
          </div>
        </div>

        <!-- (5) Bottom Action Row -->
        <div class="bg-[#F8FAFC] border-t border-[#DFE6F2] px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4">

          <div class="flex items-center gap-3 w-full sm:w-auto">
            <!-- Upload Doc Button -->
            <label class="px-4 py-3 rounded-xl bg-white border border-[#DFE6F2] text-[#172033] text-xs font-medium hover:bg-[#F5F8FF] transition-colors shadow-2xs cursor-pointer flex items-center gap-2 shrink-0">
              <svg class="w-4 h-4 text-[#173EA5]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
              <span>Upload Doc / Image</span>
              <input type="file" id="upload-file" accept=".txt,.md,.jpg,.jpeg,.png,.webp" class="hidden" />
            </label>

            <!-- Clear Button -->
            <button id="clear-btn" type="button" class="px-4 py-3 rounded-xl bg-red-50 border border-red-200 text-red-600 text-xs font-medium hover:bg-red-100 transition-colors flex items-center gap-1.5 shrink-0">
              <span>🗑️</span> Clear
            </button>
          </div>

          <!-- Convert to PDF Primary Button -->
          <div class="w-full sm:w-auto flex-1 max-w-md">
            <button id="convert-btn" type="button" class="w-full py-3.5 px-8 rounded-full bg-[#173EA5] text-white text-sm font-semibold hover:bg-[#4778F5] transition-all shadow-lg shadow-[#173EA5]/20 flex items-center justify-center gap-2">
              <span>Convert to PDF</span>
              <span class="text-base">↓</span>
            </button>

            <!-- Progress Indicator -->
            <div id="progress-container" class="hidden space-y-1.5 pt-2">
              <div class="flex justify-between text-xs font-mono text-[#64748b]">
                <span id="progress-text">Generating PDF...</span>
                <span id="progress-pct">0%</span>
              </div>
              <div class="w-full h-2 bg-[#DFE6F2] rounded-full overflow-hidden">
                <div id="progress-bar" class="w-0 h-full bg-[#173EA5] transition-all duration-200"></div>
              </div>
            </div>

            <!-- Output Download Box -->
            <div id="output-actions" class="hidden pt-2 flex items-center gap-2">
              <a id="download-link" download="paperepair-document.pdf" class="flex-1 py-3 px-4 rounded-xl bg-emerald-600 text-white text-center text-xs font-semibold hover:bg-emerald-700 transition-colors shadow-sm flex items-center justify-center gap-1.5">
                <span>⬇ Download PDF</span>
                <span id="output-size" class="text-[10px] font-mono opacity-80">(0 KB)</span>
              </a>
              <button id="reset-convert-btn" type="button" class="py-3 px-4 rounded-xl bg-white border border-[#DFE6F2] text-[#172033] text-xs font-medium hover:bg-[#F5F8FF]">
                Reset
              </button>
            </div>
          </div>

          <!-- Live word & character counter -->
          <div class="text-xs font-mono text-[#64748b] text-right w-full sm:w-auto">
            <span id="live-stats">0 words | 0 characters</span>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- How it works (4 steps, 2x2 grid on desktop, compact list on mobile) -->
  <section class="py-20 px-6 bg-white border-t border-[#DFE6F2]">
    <div class="max-w-4xl mx-auto space-y-10">
      <div class="text-center max-w-xl mx-auto space-y-3">
        <h2 class="text-3xl font-semibold tracking-tight text-[#172033]">How it works</h2>
        <p class="text-sm text-[#475569]">Turn text or notes into a clean PDF in seconds.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[#F5F8FF] border border-[#DFE6F2] rounded-2xl p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#173EA5] text-white font-mono text-sm flex items-center justify-center font-bold shrink-0">1</div>
          <div class="space-y-1">
            <h3 class="font-semibold text-[#172033]">Type or paste your text</h3>
            <p class="text-xs text-[#475569] leading-relaxed">Type directly or upload a .txt / .md file into the writing area.</p>
          </div>
        </div>
        <div class="bg-[#F5F8FF] border border-[#DFE6F2] rounded-2xl p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#173EA5] text-white font-mono text-sm flex items-center justify-center font-bold shrink-0">2</div>
          <div class="space-y-1">
            <h3 class="font-semibold text-[#172033]">Format it with the toolbar</h3>
            <p class="text-xs text-[#475569] leading-relaxed">Apply headings, font families, styles, lists, and links.</p>
          </div>
        </div>
        <div class="bg-[#F5F8FF] border border-[#DFE6F2] rounded-2xl p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#173EA5] text-white font-mono text-sm flex items-center justify-center font-bold shrink-0">3</div>
          <div class="space-y-1">
            <h3 class="font-semibold text-[#172033]">Choose page size & margins</h3>
            <p class="text-xs text-[#475569] leading-relaxed">Select page size, orientation, and margins from the page options menu.</p>
          </div>
        </div>
        <div class="bg-[#F5F8FF] border border-[#DFE6F2] rounded-2xl p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#173EA5] text-white font-mono text-sm flex items-center justify-center font-bold shrink-0">4</div>
          <div class="space-y-1">
            <h3 class="font-semibold text-[#172033]">Click Convert to PDF</h3>
            <p class="text-xs text-[#475569] leading-relaxed">Download your professional document instantly.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-20 px-6 bg-[#F5F8FF] border-t border-[#DFE6F2]">
    <div class="max-w-4xl mx-auto space-y-12">
      <div class="text-center space-y-3">
        <h2 class="text-3xl font-semibold tracking-tight text-[#172033]">Frequently Asked Questions</h2>
      </div>

      <div class="space-y-4">
        <div class="bg-white border border-[#DFE6F2] rounded-2xl p-6">
          <h3 class="font-semibold text-[#172033] mb-2 text-sm">Does this tool preserve text formatting?</h3>
          <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">Yes! You can format text with bold, italic, underline, heading styles, and custom font families.</p>
        </div>
        <div class="bg-white border border-[#DFE6F2] rounded-2xl p-6">
          <h3 class="font-semibold text-[#172033] mb-2 text-sm">How is Hindi and Unicode text handled?</h3>
          <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">Note: Complex Devanagari script shaping and conjuncts have limited support in client-side PDF rendering libraries currently.</p>
        </div>
        <div class="bg-white border border-[#DFE6F2] rounded-2xl p-6">
          <h3 class="font-semibold text-[#172033] mb-2 text-sm">Are there any file size or text limits?</h3>
          <p class="text-xs sm:text-sm text-[#475569] leading-relaxed">Processing runs entirely in your browser. Limits depend only on your device memory.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Tools -->
  {relatedTools.length > 0 && (
    <section class="py-20 px-6 bg-white border-t border-[#DFE6F2]">
      <div class="max-w-4xl mx-auto space-y-8">
        <h2 class="font-mono text-xs uppercase text-[#64748b] tracking-wider">Related Utilities</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedTools.map(rt => (
            <a href={`/tools/${rt.slug}`} class="bg-white border border-[#DFE6F2] rounded-2xl p-6 hover:border-[#173EA5] transition-all group shadow-2xs">
              <h3 class="font-semibold text-[#172033] text-base mb-2 group-hover:text-[#173EA5] transition-colors">{rt.name}</h3>
              <p class="text-xs text-[#475569] line-clamp-2 leading-relaxed">{rt.shortDesc}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Footer />

  <!-- Client-side Editor & PDF generation script using TipTap & jsPDF -->
  <script>
    import { Editor } from '@tiptap/core';
    import StarterKit from '@tiptap/starter-kit';
    import Underline from '@tiptap/extension-underline';
    import Link from '@tiptap/extension-link';
    import TextAlign from '@tiptap/extension-text-align';
    import { TextStyle } from '@tiptap/extension-text-style';
    import { Color } from '@tiptap/extension-color';
    import Highlight from '@tiptap/extension-highlight';
    import Image from '@tiptap/extension-image';
    import { Table } from '@tiptap/extension-table';
    import { TableRow } from '@tiptap/extension-table-row';
    import { TableCell } from '@tiptap/extension-table-cell';
    import { TableHeader } from '@tiptap/extension-table-header';
    import Subscript from '@tiptap/extension-subscript';
    import Superscript from '@tiptap/extension-superscript';
    import { jsPDF } from 'jspdf';

    const STORAGE_KEY = 'paperepair_text_to_pdf_content';

    // Initialize TipTap Editor
    const editorElement = document.getElementById('editor');
    const samplePillContainer = document.getElementById('sample-pill-container');
    const samplePillBtn = document.getElementById('sample-pill-btn');
    const liveStats = document.getElementById('live-stats');
    const convertBtn = document.getElementById('convert-btn');
    const progressContainer = document.getElementById('progress-container');
    const progressBar = document.getElementById('progress-bar');
    const progressText = document.getElementById('progress-text');
    const progressPct = document.getElementById('progress-pct');
    const outputActions = document.getElementById('output-actions');
    const outputSize = document.getElementById('output-size');
    const downloadLink = document.getElementById('download-link');
    const resetConvertBtn = document.getElementById('reset-convert-btn');
    const clearBtn = document.getElementById('clear-btn');
    const uploadFile = document.getElementById('upload-file') as HTMLInputElement;

    // Dropdowns & Toolbar controls
    const menuPageBtn = document.getElementById('menu-page-btn');
    const menuPageDropdown = document.getElementById('menu-page-dropdown');
    const menuInsertBtn = document.getElementById('menu-insert-btn');
    const menuInsertDropdown = document.getElementById('menu-insert-dropdown');

    const tbUndo = document.getElementById('tb-undo') as HTMLButtonElement;
    const tbRedo = document.getElementById('tb-redo') as HTMLButtonElement;
    const tbFont = document.getElementById('tb-font') as HTMLSelectElement;
    const tbStyle = document.getElementById('tb-style') as HTMLSelectElement;
    const tbFontsizeDec = document.getElementById('tb-fontsize-dec') as HTMLButtonElement;
    const tbFontsizeInc = document.getElementById('tb-fontsize-inc') as HTMLButtonElement;
    const tbFontsizeInput = document.getElementById('tb-fontsize-input') as HTMLInputElement;
    const tbBold = document.getElementById('tb-bold') as HTMLButtonElement;
    const tbItalic = document.getElementById('tb-italic') as HTMLButtonElement;
    const tbUnderline = document.getElementById('tb-underline') as HTMLButtonElement;
    const tbStrike = document.getElementById('tb-strike') as HTMLButtonElement;
    const tbCode = document.getElementById('tb-code') as HTMLButtonElement;
    const tbColor = document.getElementById('tb-color') as HTMLInputElement;
    const tbHighlight = document.getElementById('tb-highlight') as HTMLInputElement;
    const tbAlign = document.getElementById('tb-align') as HTMLSelectElement;

    // Options
    const optFilename = document.getElementById('opt-filename') as HTMLInputElement;
    const optPagesize = document.getElementById('opt-pagesize') as HTMLSelectElement;
    const optOrientation = document.getElementById('opt-orientation') as HTMLSelectElement;
    const optMargin = document.getElementById('opt-margin') as HTMLSelectElement;

    let initialContent = localStorage.getItem(STORAGE_KEY) || '<p>Start typing, pasting text, or click Sample Document above...</p>';

    const editor = new Editor({
      element: editorElement,
      extensions: [
        StarterKit,
        Underline,
        Link.configure({ openOnClick: false }),
        TextAlign.configure({ types: ['heading', 'paragraph'] }),
        TextStyle,
        Color,
        Highlight.configure({ multicolor: true }),
        Image,
        Table.configure({ resizable: true }),
        TableRow,
        TableCell,
        TableHeader,
        Subscript,
        Superscript
      ],
      content: initialContent,
      onUpdate: ({ editor }) => {
        const html = editor.getHTML();
        const text = editor.getText();
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;
        const chars = text.length;
        if (liveStats) liveStats.textContent = `${words} words | ${chars} characters`;

        try {
          localStorage.setItem(STORAGE_KEY, html);
        } catch (e) {}

        // Toggle sample pill visibility
        if (samplePillContainer) {
          if (!text.trim() || text.includes('Start typing, pasting text')) {
            samplePillContainer.classList.remove('hidden');
          } else {
            samplePillContainer.classList.add('hidden');
          }
        }
      }
    });

    // Trigger initial state update
    setTimeout(() => {
      editor.commands.focus();
    }, 100);

    // Dropdown toggles
    menuPageBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      menuPageDropdown?.classList.toggle('hidden');
      menuInsertDropdown?.classList.add('hidden');
    });

    menuInsertBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      menuInsertDropdown?.classList.toggle('hidden');
      menuPageDropdown?.classList.add('hidden');
    });

    document.addEventListener('click', () => {
      menuPageDropdown?.classList.add('hidden');
      menuInsertDropdown?.classList.add('hidden');
    });

    // Toolbar actions
    tbUndo?.addEventListener('click', () => editor.chain().focus().undo().run());
    tbRedo?.addEventListener('click', () => editor.chain().focus().redo().run());

    tbBold?.addEventListener('click', () => editor.chain().focus().toggleBold().run());
    tbItalic?.addEventListener('click', () => editor.chain().focus().toggleItalic().run());
    tbUnderline?.addEventListener('click', () => editor.chain().focus().toggleUnderline().run());
    tbStrike?.addEventListener('click', () => editor.chain().focus().toggleStrike().run());
    tbCode?.addEventListener('click', () => editor.chain().focus().toggleCode().run());

    tbColor?.addEventListener('input', (e) => {
      const color = (e.target as HTMLInputElement).value;
      editor.chain().focus().setColor(color).run();
    });

    tbHighlight?.addEventListener('input', (e) => {
      const color = (e.target as HTMLInputElement).value;
      editor.chain().focus().toggleHighlight({ color }).run();
    });

    tbAlign?.addEventListener('change', (e) => {
      const align = (e.target as HTMLSelectElement).value;
      editor.chain().focus().setTextAlign(align).run();
    });

    tbStyle?.addEventListener('change', (e) => {
      const val = (e.target as HTMLSelectElement).value;
      if (val === 'p') editor.chain().focus().setParagraph().run();
      else if (val === 'h1') editor.chain().focus().toggleHeading({ level: 1 }).run();
      else if (val === 'h2') editor.chain().focus().toggleHeading({ level: 2 }).run();
      else if (val === 'h3') editor.chain().focus().toggleHeading({ level: 3 }).run();
    });

    // Font size controls
    tbFontsizeDec?.addEventListener('click', () => {
      let cur = parseInt(tbFontsizeInput.value) || 16;
      if (cur > 8) {
        cur -= 2;
        tbFontsizeInput.value = cur.toString();
      }
    });
    tbFontsizeInc?.addEventListener('click', () => {
      let cur = parseInt(tbFontsizeInput.value) || 16;
      if (cur < 72) {
        cur += 2;
        tbFontsizeInput.value = cur.toString();
      }
    });

    // Insert menu actions
    document.getElementById('ins-hr')?.addEventListener('click', () => editor.chain().focus().setHorizontalRule().run());
    document.getElementById('ins-pagebreak')?.addEventListener('click', () => editor.chain().focus().setHardBreak().run());
    document.getElementById('ins-date')?.addEventListener('click', () => {
      const dateStr = new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
      editor.chain().focus().insertContent(dateStr).run();
    });
    document.getElementById('ins-table')?.addEventListener('click', () => {
      editor.chain().focus().insertTable({ rows: 3, cols: 3, withHeaderRow: true }).run();
    });
    document.getElementById('ins-link')?.addEventListener('click', () => {
      const url = prompt('Enter URL (http://, https:// or mailto:):', 'https://');
      if (url && (url.startsWith('http://') || url.startsWith('https://') || url.startsWith('mailto:'))) {
        editor.chain().focus().setLink({ href: url }).run();
      } else if (url) {
        alert('Invalid URL. Must start with http://, https:// or mailto:');
      }
    });
    document.getElementById('ins-image')?.addEventListener('click', () => {
      const fileInput = document.createElement('input');
      fileInput.type = 'file';
      fileInput.accept = 'image/jpeg,image/png,image/webp';
      fileInput.onchange = (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (evt) => {
            const dataUrl = evt.target?.result as string;
            // Downscale image if large (>2000px)
            const img = new Image();
            img.onload = () => {
              let w = img.width;
              let h = img.height;
              const maxDim = 1200;
              if (w > maxDim || h > maxDim) {
                if (w > h) {
                  h = Math.round((h * maxDim) / w);
                  w = maxDim;
                } else {
                  w = Math.round((w * maxDim) / h);
                  h = maxDim;
                }
              }
              const canvas = document.createElement('canvas');
              canvas.width = w;
              canvas.height = h;
              const ctx = canvas.getContext('2d');
              ctx?.drawImage(img, 0, 0, w, h);
              const resizedDataUrl = canvas.toDataURL('image/jpeg', 0.85);
              editor.chain().focus().setImage({ src: resizedDataUrl }).run();
            };
            img.src = dataUrl;
          };
          reader.readAsDataURL(file);
        }
      };
      fileInput.click();
    });

    // Sample Document Button / Pill
    const sampleText = `<h1>PaperRepair Professional Document</h1>
<p>Welcome to the PaperRepair Text-to-PDF Studio. This document demonstrates rich text formatting, professional headings, bullet points, and high-quality client-side PDF export.</p>
<h2>Key Features</h2>
<p>• Fast client-side rendering with zero server uploads.</p>
<p>• Support for custom font families, page sizes, margins, and orientations.</p>
<p>• Clean multi-page pagination and clean export.</p>
<p><em>Thank you for using PaperRepair!</em></p>`;

    sampleBtn?.addEventListener('click', () => {
      editor.commands.setContent(sampleText);
    });
    samplePillBtn?.addEventListener('click', () => {
      editor.commands.setContent(sampleText);
    });

    // Upload Text / Image File
    uploadFile?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (!file) return;
      if (file.type.startsWith('image/')) {
        const reader = new FileReader();
        reader.onload = (evt) => {
          editor.chain().focus().setImage({ src: evt.target?.result as string }).run();
        };
        reader.readAsDataURL(file);
      } else {
        const reader = new FileReader();
        reader.onload = (evt) => {
          const content = evt.target?.result as string;
          editor.commands.setContent(`<p>${content.replace(/\n/g, '<br>')}</p>`);
        };
        reader.readAsText(file);
      }
    });

    // Clear Button
    clearBtn?.addEventListener('click', () => {
      if (confirm('Are you sure you want to clear the editor?')) {
        editor.commands.setContent('');
        localStorage.removeItem(STORAGE_KEY);
      }
    });

    // Convert to PDF using jsPDF
    convertBtn?.addEventListener('click', async () => {
      const text = editor.getText();
      if (!text.trim()) {
        alert('Please enter some text before converting to PDF.');
        return;
      }

      convertBtn.classList.add('hidden');
      progressContainer?.classList.remove('hidden');
      if (progressBar) progressBar.style.width = '30%';
      if (progressPct) progressPct.textContent = '30%';

      try {
        await new Promise(r => setTimeout(r, 200));
        if (progressBar) progressBar.style.width = '60%';
        if (progressPct) progressPct.textContent = '60%';

        const pageSize = optPagesize?.value || 'a4';
        const orientation = optOrientation?.value || 'portrait';
        const marginMm = parseFloat(optMargin?.value || '20');

        let format = [210, 297]; // A4 default
        if (pageSize === 'letter') format = [215.9, 279.4];
        else if (pageSize === 'legal') format = [215.9, 355.6];
        else if (pageSize === 'tabloid') format = [279.4, 431.8];
        else if (pageSize === 'a3') format = [297, 420];
        else if (pageSize === 'a5') format = [148, 210];
        else if (pageSize === 'b4') format = [250, 353];
        else if (pageSize === 'b5') format = [176, 250];
        else if (pageSize === 'statement') format = [139.7, 215.9];
        else if (pageSize === 'executive') format = [184.15, 266.7];
        else if (pageSize === 'folio') format = [215.9, 330.2];
        else if (pageSize === 'pageless') format = [210, 500]; // continuous height

        const doc = new jsPDF({
          orientation: orientation as any,
          unit: 'mm',
          format: format as any
        });

        if (progressBar) progressBar.style.width = '85%';
        if (progressPct) progressPct.textContent = '85%';

        // Use html method or text rendering
        const contentHtml = editor.getHTML();
        const tempDiv = document.createElement('div');
        tempDiv.style.width = '170mm';
        tempDiv.style.padding = '10px';
        tempDiv.style.fontFamily = tbFont?.value || 'sans-serif';
        tempDiv.style.fontSize = `${tbFontsizeInput?.value || 16}px`;
        tempDiv.style.color = '#172033';
        tempDiv.innerHTML = contentHtml;

        await doc.html(tempDiv, {
          callback: function (doc) {
            if (progressBar) progressBar.style.width = '100%';
            if (progressPct) progressPct.textContent = '100%';

            const pdfBlob = doc.output('blob');
            const blobUrl = URL.createObjectURL(pdfBlob);
            const sizeKb = Math.round(pdfBlob.size / 1024);

            setTimeout(() => {
              progressContainer?.classList.add('hidden');
              outputActions?.classList.remove('hidden');
              if (outputSize) outputSize.textContent = `(${sizeKb} KB)`;
              if (downloadLink) {
                downloadLink.href = blobUrl;
                downloadLink.download = optFilename?.value || 'paperepair-document.pdf';
              }
            }, 300);
          },
          x: marginMm,
          y: marginMm,
          autoPaging: true,
          windowWidth: 800
        });

      } catch (err: any) {
        console.error(err);
        alert('Error generating PDF: ' + (err.message || err));
        convertBtn.classList.remove('hidden');
        progressContainer?.classList.add('hidden');
      }
    });

    resetConvertBtn?.addEventListener('click', () => {
      outputActions?.classList.add('hidden');
      convertBtn.classList.remove('hidden');
    });

  </script>
</Layout>
