  <!-- FOOTER -->
  <Footer />

  <!-- SECTION — BACK TO TOP BUTTON -->
  <button
    id="back-to-top"
    aria-label="Back to top"
    class="fixed bottom-8 right-8 z-50 w-11 h-11 rounded-full bg-[#1F1F1F] border border-[#2E2E2E] text-[#EDEDED] shadow-2xl flex items-center justify-center opacity-0 pointer-events-none hover:bg-[#4778F5] hover:border-[#4778F5] transition-all duration-300"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
    </svg>
  </button>

  <script>
    const searchInput = document.getElementById('hero-search') as HTMLInputElement;
    const hubTabs = document.querySelectorAll('.hub-tab');
    const hubCards = document.querySelectorAll('.hub-card');
    const hubEmpty = document.getElementById('hub-empty');
    const revealAllBtn = document.getElementById('reveal-all-btn');
    const revealBtnText = document.getElementById('reveal-btn-text');
    const backToTopBtn = document.getElementById('back-to-top');

    let activeCat = 'all';
    let queryText = '';
    let allRevealed = false;

    function filterHub() {
      let count = 0;
      hubCards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.getAttribute('data-category');
        const name = el.getAttribute('data-name') || '';
        const desc = el.getAttribute('data-desc') || '';

        const matchCat = activeCat === 'all' || cat === activeCat;
        const matchQuery = !queryText || name.includes(queryText) || desc.includes(queryText);

        if (matchCat && matchQuery) {
          // If not all revealed and cat is 'all', only show first 10 unless filtered by specific cat or query
          if (activeCat === 'all' && !queryText && !allRevealed && el.classList.contains('extra-tool')) {
            el.style.display = 'none';
          } else {
            el.style.display = 'flex';
            count++;
          }
        } else {
          el.style.display = 'none';
        }
      });

      if (hubEmpty) {
        if (count === 0) {
          hubEmpty.classList.remove('hidden');
        } else {
          hubEmpty.classList.add('hidden');
        }
      }
    }

    function updateTabStyles() {
      hubTabs.forEach((t) => {
        const cat = t.getAttribute('data-cat') || 'all';
        if (cat === activeCat) {
          t.classList.remove('text-[#7f8c99]', 'hover:text-white');
          t.classList.add('bg-[#1b8ae6]', 'text-white', 'shadow-sm');
        } else {
          t.classList.remove('bg-[#1b8ae6]', 'text-white', 'shadow-sm');
          t.classList.add('text-[#7f8c99]', 'hover:text-white');
        }
      });
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        queryText = (e.target as HTMLInputElement).value.toLowerCase();
        filterHub();
      });
    }

    hubTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        activeCat = tab.getAttribute('data-cat') || 'all';
        updateTabStyles();
        filterHub();
      });
    });

    // Initialize tab styles and filtering
    updateTabStyles();
    filterHub();

    if (revealAllBtn) {
      revealAllBtn.addEventListener('click', () => {
        allRevealed = !allRevealed;
        if (allRevealed) {
          if (revealBtnText) revealBtnText.textContent = 'Show Less';
        } else {
          if (revealBtnText) revealBtnText.textContent = 'All Tools';
        }
        filterHub();
      });
    }

    // Back to Top functionality
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTopBtn?.classList.remove('opacity-0', 'pointer-events-none');
        backToTopBtn?.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        backToTopBtn?.classList.add('opacity-0', 'pointer-events-none');
        backToTopBtn?.classList.remove('opacity-100', 'pointer-events-auto');
      }
    });

    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });

    // FAQ Accordion & Toggle functionality
    const faqItems = document.querySelectorAll('.faq-item');
    const faqToggleBtn = document.getElementById('faq-toggle-btn');
    let faqsExpanded = false;

    faqItems.forEach((item) => {
      const btn = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer') as HTMLElement;
      const arrow = item.querySelector('.faq-arrow') as HTMLElement;

      btn?.addEventListener('click', () => {
        const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';

        // Close all other FAQs
        faqItems.forEach((otherItem) => {
          const otherAnswer = otherItem.querySelector('.faq-answer') as HTMLElement;
          const otherArrow = otherItem.querySelector('.faq-arrow') as HTMLElement;
          if (otherAnswer) {
            otherAnswer.style.maxHeight = '0px';
          }
          if (otherArrow) {
            otherArrow.style.transform = 'rotate(0deg)';
          }
        });

        // If it wasn't open, open it
        if (!isOpen) {
          answer.style.maxHeight = answer.scrollHeight + 'px';
          if (arrow) {
            arrow.style.transform = 'rotate(180deg)';
          }
        }
      });
    });

    if (faqToggleBtn) {
      faqToggleBtn.addEventListener('click', () => {
        faqsExpanded = !faqsExpanded;
        const hiddenFaqs = document.querySelectorAll('.faq-hidden');
        hiddenFaqs.forEach((faq) => {
          faq.classList.toggle('hidden');
        });

        if (faqsExpanded) {
          faqToggleBtn.textContent = 'Show Less';
        } else {
          faqToggleBtn.textContent = '+4 More';
          // Collapse hidden ones if hiding again
          hiddenFaqs.forEach((item) => {
            const answer = item.querySelector('.faq-answer') as HTMLElement;
            const arrow = item.querySelector('.faq-arrow') as HTMLElement;
            if (answer) answer.style.maxHeight = '0px';
            if (arrow) arrow.style.transform = 'rotate(0deg)';
          });
        }
      });
    }
  </script>
</Layout>
