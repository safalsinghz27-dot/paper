---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TOOLS } from '../data/tools';
---

<Layout title="CipherPDF — Secure Browser-Based PDF & Document Utilities" description="Lightning-fast, private, secure browser-based document utilities. Convert, extract, repair, and manipulate PDF, Word, Excel, CSV, JPG, and Text files instantly in your browser with zero server uploads.">
  <Header />

  <!-- CONTINUOUS TOP AREA (Hero + Category Cards + Trust Strip) -->
  <div class="bg-[#171717] border-b border-[#2E2E2E]/60">
    <main class="max-w-[1440px] mx-auto px-10 py-10 space-y-8">

      <!-- SECTION 2 — HERO -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center py-6">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#1F1F1F] border border-[#2E2E2E] text-xs font-mono text-[#EDEDED]">
            <span class="w-2 h-2 rounded-full bg-[#4778F5] animate-pulse"></span>
            Secure Client-Side Document Utilities
          </div>

          <h1 class="text-4xl sm:text-[46px] font-semibold tracking-tight text-[#EDEDED] leading-[1.1]">
            Secure Browser-Based PDF & Document Utilities
          </h1>

          <p class="text-sm sm:text-base text-[#FFFFFF] max-w-xl leading-relaxed">
            Convert, extract, and manipulate PDF, Word, Excel, CSV, text and image files instantly in your browser with zero remote server uploads.
          </p>

          <!-- Search Bar -->
          <div class="max-w-xl pt-2">
            <div class="relative flex items-center bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl h-14 shadow-lg focus-within:border-[#4778F5] transition-all">
              <svg class="absolute left-4 w-4 h-4 text-[#FFFFFF]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <input
                type="text"
                id="hero-search"
                placeholder="Search tools..."
                class="w-full bg-transparent pl-11 pr-4 text-sm text-[#EDEDED] placeholder-[#A3A3A3] focus:outline-none"
              />
              <a href="/tools" class="mr-2 px-6 py-2.5 rounded-lg bg-[#4778F5] text-white text-xs font-medium hover:bg-[#3b63d0] transition-colors shrink-0">
                Search
              </a>
            </div>
          </div>
        </div>

        <!-- Right Illustration -->
        <div class="lg:col-span-5">
          <div class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-6 shadow-xl relative overflow-hidden aspect-video flex flex-col justify-between">
            <div class="flex items-center justify-between border-b border-[#2E2E2E] pb-3">
              <div class="flex items-center gap-2">
                <div class="w-2.5 h-2.5 rounded-full bg-red-500/80"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-green-500/80"></div>
              </div>
              <span class="text-[10px] font-mono text-[#A3A3A3]">cipherpdf.com</span>
            </div>
            <div class="space-y-2 py-4">
              <div class="h-3 bg-[#2E2E2E] rounded-md w-3/4"></div>
              <div class="h-2.5 bg-[#2E2E2E]/60 rounded-md w-full"></div>
              <div class="h-2.5 bg-[#2E2E2E]/60 rounded-md w-5/6"></div>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-[#2E2E2E] text-[10px] font-mono text-[#4778F5]">
              <span>Client Encryption Active</span>
              <span>100% Secure</span>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 3 — FOUR CATEGORY CARDS -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <a href="/tools?cat=PDF" class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl p-4 hover:border-purple-400 hover:-translate-y-0.5 transition-all group flex flex-col justify-between h-[120px]">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-purple-500/15 text-purple-400 flex items-center justify-center font-bold text-xs">PDF</div>
            <span class="text-xs text-[#A3A3A3] group-hover:text-purple-400 group-hover:translate-x-0.5 transition-all">↗</span>
          </div>
          <div>
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-[#EDEDED]">PDF Tools</h3>
              <span class="text-[10px] font-mono text-purple-400 font-semibold px-2 py-0.5 rounded-full bg-purple-500/10">5 tools</span>
            </div>
            <p class="text-[11px] text-[#FFFFFF] line-clamp-1 mt-0.5">Text to PDF, PDF to Text, CSV, HTML</p>
          </div>
        </a>

        <a href="/tools?cat=Image" class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl p-4 hover:border-[#6E96FF] hover:-translate-y-0.5 transition-all group flex flex-col justify-between h-[120px]">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-[#6E96FF]/15 text-[#6E96FF] flex items-center justify-center font-bold text-xs">IMG</div>
            <span class="text-xs text-[#A3A3A3] group-hover:text-[#6E96FF] group-hover:translate-x-0.5 transition-all">↗</span>
          </div>
          <div>
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-[#EDEDED]">Image Tools</h3>
              <span class="text-[10px] font-mono text-[#6E96FF] font-semibold px-2 py-0.5 rounded-full bg-[#6E96FF]/10">2 tools</span>
            </div>
            <p class="text-[11px] text-[#FFFFFF] line-clamp-1 mt-0.5">Image to PDF & Text to Image utilities</p>
          </div>
        </a>

        <a href="/tools?cat=Document Converter" class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl p-4 hover:border-[#4778F5] hover:-translate-y-0.5 transition-all group flex flex-col justify-between h-[120px]">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-[#4778F5]/15 text-[#4778F5] flex items-center justify-center font-bold text-xs">DOC</div>
            <span class="text-xs text-[#A3A3A3] group-hover:text-[#4778F5] group-hover:translate-x-0.5 transition-all">↗</span>
          </div>
          <div>
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-[#EDEDED]">Convert Tools</h3>
              <span class="text-[10px] font-mono text-[#4778F5] font-semibold px-2 py-0.5 rounded-full bg-[#4778F5]/10">7 tools</span>
            </div>
            <p class="text-[11px] text-[#FFFFFF] line-clamp-1 mt-0.5">Word, Excel, CSV, and JPG converters</p>
          </div>
        </a>

        <a href="/tools" class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl p-4 hover:border-emerald-400 hover:-translate-y-0.5 transition-all group flex flex-col justify-between h-[120px]">
          <div class="flex items-center justify-between">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/15 text-emerald-400 flex items-center justify-center font-bold text-xs">ALL</div>
            <span class="text-xs text-[#A3A3A3] group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-all">↗</span>
          </div>
          <div>
            <div class="flex items-center justify-between">
              <h3 class="text-sm font-semibold text-[#EDEDED]">All Tools</h3>
              <span class="text-[10px] font-mono text-emerald-400 font-semibold px-2 py-0.5 rounded-full bg-emerald-500/10">14 utils</span>
            </div>
            <p class="text-[11px] text-[#FFFFFF] line-clamp-1 mt-0.5">Complete directory of all 14 utilities</p>
          </div>
        </a>
      </section>

      <!-- SECTION 4 — TRUST / STATISTICS SECTION -->
      <section class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl py-3 px-6 grid grid-cols-2 md:grid-cols-4 gap-4 items-center divide-y md:divide-y-0 md:divide-x divide-[#2E2E2E]/60">
        <!-- 1. Fast Conversion -->
        <div class="flex items-center gap-3 px-2 pt-2 md:pt-0">
          <div class="w-8 h-8 rounded-lg bg-[#171717] border border-[#2E2E2E] flex items-center justify-center text-[#4778F5] shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div>
            <div class="text-xs font-semibold text-[#EDEDED]">Fast Conversion</div>
            <div class="text-[10px] text-[#FFFFFF]">Instant browser processing</div>
          </div>
        </div>

        <!-- 2. Secure Processing -->
        <div class="flex items-center gap-3 px-2 pt-2 md:pt-0 md:pl-6">
          <div class="w-8 h-8 rounded-lg bg-[#171717] border border-[#2E2E2E] flex items-center justify-center text-emerald-400 shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <div>
            <div class="text-xs font-semibold text-[#EDEDED]">Secure Processing</div>
            <div class="text-[10px] text-[#FFFFFF]">100% client-side privacy</div>
          </div>
        </div>

        <!-- 3. Multiple Formats -->
        <div class="flex items-center gap-3 px-2 pt-2 md:pt-0 md:pl-6">
          <div class="w-8 h-8 rounded-lg bg-[#171717] border border-[#2E2E2E] flex items-center justify-center text-[#6E96FF] shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"/>
            </svg>
          </div>
          <div>
            <div class="text-xs font-semibold text-[#EDEDED]">Multiple Formats</div>
            <div class="text-[10px] text-[#FFFFFF]">PDF, Word, Excel, JPG & more</div>
          </div>
        </div>

        <!-- 4. Free to Use -->
        <div class="flex items-center gap-3 px-2 pt-2 md:pt-0 md:pl-6">
          <div class="w-8 h-8 rounded-lg bg-[#171717] border border-[#2E2E2E] flex items-center justify-center text-amber-400 shrink-0">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"/>
            </svg>
          </div>
          <div>
            <div class="text-xs font-semibold text-[#EDEDED]">Free to Use</div>
            <div class="text-[10px] text-[#FFFFFF]">No subscription or sign-up</div>
          </div>
        </div>
      </section>

    </main>
  </div>

  <!-- SECTION 5 — MOST POPULAR TOOLS (bg #242424 with abstract waves) -->
  <section class="bg-[#242424] relative overflow-hidden py-16 border-b border-[#2E2E2E]">
    <!-- Abstract Wave Background SVG -->
    <div class="absolute inset-0 pointer-events-none opacity-20 overflow-hidden">
      <svg class="w-full h-full text-[#3A3A3A]" viewBox="0 0 1440 600" fill="none" preserveAspectRatio="none">
        <path d="M-100 100 C 300 200, 500 0, 900 150 C 1300 300, 1500 100, 1600 200" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 250 C 400 350, 600 150, 1000 300 C 1400 450, 1500 250, 1600 350" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 400 C 350 500, 700 300, 1100 450 C 1450 550, 1550 350, 1650 500" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </div>

    <div class="max-w-[1440px] mx-auto px-10 relative z-10 space-y-8">
      <!-- Section Heading & Subtitle -->
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-3xl font-semibold tracking-tight text-[#EDEDED]">Popular Tools</h2>
        <p class="text-xs sm:text-sm text-[#EDEDED]">
          Explore our most frequently used browser-based document utilities for fast and secure file processing.
        </p>
      </div>

      <!-- Category Selector Tabs (All Tools FIRST) -->
      <div class="flex flex-wrap items-center justify-center gap-2">
        <button class="hub-tab active px-5 py-2.5 rounded-full text-xs font-medium bg-[#4778F5] text-white transition-all shadow-sm flex items-center gap-2" data-cat="all">
          <span>All Tools</span>
        </button>
        <button class="hub-tab px-5 py-2.5 rounded-full text-xs font-medium bg-[#1F1F1F] border border-[#2E2E2E] text-[#A3A3A3] hover:text-[#EDEDED] hover:border-[#4778F5] transition-all flex items-center gap-2" data-cat="PDF Tools">
          <span>PDF Tools</span>
        </button>
        <button class="hub-tab px-5 py-2.5 rounded-full text-xs font-medium bg-[#1F1F1F] border border-[#2E2E2E] text-[#A3A3A3] hover:text-[#EDEDED] hover:border-[#4778F5] transition-all flex items-center gap-2" data-cat="Image Tools">
          <span>Image Tools</span>
        </button>
        <button class="hub-tab px-5 py-2.5 rounded-full text-xs font-medium bg-[#1F1F1F] border border-[#2E2E2E] text-[#A3A3A3] hover:text-[#EDEDED] hover:border-[#4778F5] transition-all flex items-center gap-2" data-cat="Document Converter">
          <span>Convert Tools</span>
        </button>
      </div>

      <!-- Tool Grid (4 columns, 3 rows initially -> 10 tools visible initially) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="hub-grid">
        {TOOLS.map((tool, index) => (
          <a
            href={`/tools/${tool.slug}`}
            class={`hub-card group bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl p-4 hover:border-[#4778F5] hover:-translate-y-0.5 transition-all flex flex-col justify-between h-[120px] ${index >= 10 ? 'hidden extra-tool' : ''}`}
            data-category={tool.category}
            data-name={tool.name.toLowerCase()}
            data-desc={tool.shortDesc.toLowerCase()}
          >
            <div class="flex items-center justify-between">
              <div class="w-8 h-8 rounded-lg flex items-center justify-center shrink-0 bg-[#171717] border border-[#2E2E2E]">
              <img src={`/icons/${tool.icon}`} alt={tool.name} class="w-5 h-5" />
            </div>
              <span class="text-xs text-[#A3A3A3] group-hover:text-[#4778F5] group-hover:translate-x-0.5 transition-all">→</span>
            </div>
            <div>
              <div class="flex items-center justify-between">
                <h3 class="text-sm font-semibold text-[#EDEDED] truncate group-hover:text-[#6E96FF] transition-colors">{tool.name}</h3>
                <span class="text-[10px] font-mono text-[#A3A3A3]">{tool.category === 'PDF Tools' ? 'PDF Tools' : tool.category === 'Image Tools' ? 'Image Tools' : 'Convert Tools'}</span>
              </div>
              <p class="text-[11px] text-[#FFFFFF] line-clamp-1 mt-0.5">{tool.shortDesc}</p>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty State -->
      <div id="hub-empty" class="hidden text-center py-16">
        <h3 class="text-base font-semibold text-[#EDEDED]">No matching document utilities found</h3>
        <p class="text-xs text-[#FFFFFF] mt-1">Try searching with a different keyword or category filter.</p>
      </div>

      <!-- Bottom All Tools Button -->
      <div class="flex justify-center pt-4">
        <button id="reveal-all-btn" class="px-8 py-3 rounded-xl bg-[#1F1F1F] border border-[#2E2E2E] text-xs font-semibold text-[#EDEDED] hover:border-[#4778F5] hover:bg-[#2A2A2A] transition-all flex items-center gap-2 shadow-lg">
          <span id="reveal-btn-text">All Tools</span>
          <span>↓</span>
        </button>
      </div>
    </div>
  </section>

  <!-- OTHER SECTIONS (Why Choose, FAQ, Footer kept intact as per rules) -->
  <main class="max-w-[1440px] mx-auto px-10 py-16 space-y-16">
    <!-- SECTION — WHY CHOOSE CIPHERPDF -->
    <section class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-8 lg:p-12 shadow-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#171717] border border-[#2E2E2E] text-[10px] font-mono text-[#6E96FF] uppercase tracking-wider font-semibold">
            Security & Privacy Guarantee
          </div>
          <h2 class="text-3xl font-semibold tracking-tight text-[#EDEDED]">Why Choose CipherPDF?</h2>
          <p class="text-xs sm:text-sm text-[#EDEDED] leading-relaxed">
            Zero remote server uploads. All conversions, extractions, and document processing happen entirely within your local browser sandbox using modern client-side WebAssembly and JS engines.
          </p>
          <div class="grid grid-cols-2 gap-4 pt-2">
            <div class="flex items-center gap-2 text-xs text-[#EDEDED]">
              <span class="text-emerald-400 font-bold">✓</span> 100% Client-Side Processing
            </div>
            <div class="flex items-center gap-2 text-xs text-[#EDEDED]">
              <span class="text-emerald-400 font-bold">✓</span> No Registration Required
            </div>
            <div class="flex items-center gap-2 text-xs text-[#EDEDED]">
              <span class="text-emerald-400 font-bold">✓</span> Instant Lightning Speed
            </div>
            <div class="flex items-center gap-2 text-xs text-[#EDEDED]">
              <span class="text-emerald-400 font-bold">✓</span> Complete Data Privacy
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-[#242424] border border-[#2E2E2E] rounded-xl p-6 aspect-[16/9] flex items-center justify-center text-xs font-mono text-[#A3A3A3] relative overflow-hidden shadow-inner">
            <div class="absolute inset-0 bg-gradient-to-tr from-[#4778F5]/10 to-transparent"></div>
            <div class="text-center space-y-2 relative z-10">
              <div class="w-12 h-12 rounded-2xl bg-[#171717] border border-[#2E2E2E] text-[#4778F5] flex items-center justify-center mx-auto text-lg font-bold">🔒</div>
              <div class="text-xs font-semibold text-[#EDEDED]">Client-Side Conversion Engine</div>
              <div class="text-[10px] text-[#A3A3A3]">Protected by browser isolation</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION — FAQ -->
    <section class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-8 lg:p-12 space-y-6">
      <div class="text-center space-y-2">
        <h2 class="text-3xl font-semibold tracking-tight text-[#EDEDED]">Frequently Asked Questions</h2>
        <p class="text-xs text-[#EDEDED]">Everything you need to know about secure browser-based document utilities.</p>
      </div>

      <div class="space-y-3 max-w-3xl mx-auto">
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>What is CipherPDF?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>Is it completely free to use?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>Do I need to sign up or create an account?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>Is my document data secure and private?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>Can I use these utilities on mobile devices?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
      </div>
    </section>

    <!-- DEVELOPED BY MAYANK SHARMA -->
    <section class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl h-16 px-6 flex items-center justify-center gap-3 shadow-md">
      <div class="w-7 h-7 rounded-lg bg-[#4778F5] text-white font-mono text-xs font-bold flex items-center justify-center">M</div>
      <span class="text-xs font-medium text-[#EDEDED]">Developed by Mayank Sharma</span>
    </section>
  </main>

  <!-- FOOTER -->
  <Footer />

  <!-- SECTION — BACK TO TOP BUTTON -->
  <button
    id="back-to-top"
    aria-label="Back to top"
    class="fixed bottom-8 right-8 z-50 w-11 h-11 rounded-full bg-[#1F1F1F] border border-[#2E2E2E] text-[#EDEDED] shadow-2xl flex items-center justify-center opacity-0 pointer-events-none hover:bg-[#4778F5] hover:border-[#4778F5] transition-all duration-300"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
    </svg>
  </button>

  <script>
    const searchInput = document.getElementById('hero-search') as HTMLInputElement;
    const hubTabs = document.querySelectorAll('.hub-tab');
    const hubCards = document.querySelectorAll('.hub-card');
    const hubEmpty = document.getElementById('hub-empty');
    const revealAllBtn = document.getElementById('reveal-all-btn');
    const revealBtnText = document.getElementById('reveal-btn-text');
    const backToTopBtn = document.getElementById('back-to-top');

    let activeCat = 'all';
    let queryText = '';
    let allRevealed = false;

    function filterHub() {
      let count = 0;
      hubCards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.getAttribute('data-category');
        const name = el.getAttribute('data-name') || '';
        const desc = el.getAttribute('data-desc') || '';

        const matchCat = activeCat === 'all' || cat === activeCat;
        const matchQuery = !queryText || name.includes(queryText) || desc.includes(queryText);

        if (matchCat && matchQuery) {
          // If not all revealed and cat is 'all', only show first 10 unless filtered by specific cat or query
          if (activeCat === 'all' && !queryText && !allRevealed && el.classList.contains('extra-tool')) {
            el.style.display = 'none';
          } else {
            el.style.display = 'flex';
            count++;
          }
        } else {
          el.style.display = 'none';
        }
      });

      if (hubEmpty) {
        if (count === 0) {
          hubEmpty.classList.remove('hidden');
        } else {
          hubEmpty.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        queryText = (e.target as HTMLInputElement).value.toLowerCase();
        filterHub();
      });
    }

    hubTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        hubTabs.forEach(t => {
          t.classList.remove('bg-[#4778F5]', 'text-white', 'shadow-sm');
          t.classList.add('bg-[#1F1F1F]', 'border', 'border-[#2E2E2E]', 'text-[#A3A3A3]');
        });
        tab.classList.remove('bg-[#1F1F1F]', 'border', 'border-[#2E2E2E]', 'text-[#A3A3A3]');
        tab.classList.add('bg-[#4778F5]', 'text-white', 'shadow-sm');

        activeCat = tab.getAttribute('data-cat') || 'all';
        filterHub();
      });
    });

    if (revealAllBtn) {
      revealAllBtn.addEventListener('click', () => {
        allRevealed = !allRevealed;
        if (allRevealed) {
          if (revealBtnText) revealBtnText.textContent = 'Show Less';
        } else {
          if (revealBtnText) revealBtnText.textContent = 'All Tools';
        }
        filterHub();
      });
    }

    // Back to Top functionality
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTopBtn?.classList.remove('opacity-0', 'pointer-events-none');
        backToTopBtn?.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        backToTopBtn?.classList.add('opacity-0', 'pointer-events-none');
        backToTopBtn?.classList.remove('opacity-100', 'pointer-events-auto');
      }
    });

    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  </script>
</Layout>
