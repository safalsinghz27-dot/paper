        <!-- FAQ Item 8 (Initially Hidden) -->
        <div class="faq-item faq-hidden hidden border border-[#2E2E2E] rounded-xl bg-[#171717] overflow-hidden transition-all duration-300">
          <button class="faq-question w-full p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] text-left cursor-pointer hover:border-[#4778F5] transition-colors focus:outline-none">
            <span>Are my files uploaded to a remote server?</span>
