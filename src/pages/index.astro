    <!-- DEVELOPED BY MAYANK SHARMA -->
    <section class="flex items-center justify-center gap-3.5">
      <div class="w-[35px] h-[35px] rounded-lg bg-[#4778F5] text-white font-mono text-[15px] font-bold flex items-center justify-center">M</div>
