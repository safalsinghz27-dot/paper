---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { TOOLS } from '../data/tools';
---

<Layout title="CipherPDF — Secure Browser-Based PDF & Document Utilities" description="Lightning-fast, private, secure browser-based document utilities. Convert, extract, repair, and manipulate PDF, Word, Excel, CSV, JPG, and Text files instantly in your browser with zero server uploads.">
  <Header />

  <!-- CONTINUOUS TOP AREA (Hero + Category Cards) -->
  <div class="bg-[#171717]">
    <main class="max-w-[1440px] mx-auto px-10 py-10 space-y-18">

      <!-- SECTION 2 — HERO -->
      <section class="relative w-full rounded-2xl overflow-hidden" style="aspect-ratio: 21/9;">
        <!-- Background Image -->
        <img src="/hero-illustration.webp" alt="Document conversion illustration" class="absolute inset-0 w-full h-full object-cover" />

        <!-- Overlay Gradient (reduced black overlay by ~90%) -->
        <div class="absolute inset-0 bg-gradient-to-r from-[#171717]/10 via-transparent to-transparent"></div>

        <!-- Content Overlay (Left-aligned) -->
        <div class="relative h-full flex flex-col justify-center px-10 sm:px-12 lg:px-16 py-8 max-w-2xl text-left">

          <!-- Heading -->
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#EDEDED] leading-[1.15] mb-4">
            Secure Browser-Based PDF & Document Utilities
          </h1>

          <!-- Description -->
          <p class="text-sm sm:text-base text-[#FFFFFF]/95 max-w-xl leading-relaxed mb-6">
            Convert, extract, and manipulate PDF, Word, Excel, CSV, text and image files instantly in your browser with zero remote server uploads.
          </p>

          <!-- Search Bar -->
          <div class="max-w-xl mb-4">
            <div class="relative flex items-center bg-[#0F1F3C]/60 backdrop-blur-md border border-[#1b8ae6]/30 rounded-full h-14 shadow-lg focus-within:border-[#1b8ae6]/60 focus-within:bg-[#0F1F3C]/80 transition-all">
              <svg class="absolute left-5 w-4 h-4 text-[#1b8ae6]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
              <input
                type="text"
                id="hero-search"
                placeholder="Search tools..."
                class="w-full bg-transparent pl-13 pr-4 text-sm text-[#EDEDED] placeholder-[#6B8DD6] focus:outline-none"
              />
              <a href="/tools" class="mr-2 px-6 py-2.5 rounded-full bg-[#1b8ae6] text-white text-xs font-medium hover:bg-[#1572c0] transition-colors shrink-0">
                Search
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- SECTION 3 — FOUR CATEGORY CARDS (TinyWow / Reference Style) -->
      <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 relative">

        <!-- 1. PDF Tools - Cyan -->
        <a href="/tools?cat=PDF" class="group relative rounded-xl overflow-hidden bg-[#19222b] border border-[#293847] hover:border-[#06B6D4]/50 hover:-translate-y-1 transition-all duration-200 shadow-xl flex flex-col">
          <div class="p-6 bg-gradient-to-b from-[#06B6D4] to-[#0891B2] flex flex-col justify-between h-[145px] text-white relative overflow-hidden">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center p-2">
                <img src="/assets/document-text-svgrepo-com.svg" class="w-full h-full object-contain brightness-0 invert" alt="PDF Tools" />
              </div>
              <span class="text-[11px] font-semibold bg-white/25 px-2.5 py-1 rounded-full">5 tools</span>
            </div>
            <div class="flex items-end justify-between">
              <div>
                <h3 class="font-bold text-base leading-tight">PDF Tools</h3>
                <p class="text-[12px] text-white/85 mt-0.5">Solve Your PDF Problems</p>
              </div>
              <span class="text-white/80 group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
          <div class="p-3 bg-[#19222b]">
            <div class="bg-[#06B6D4]/15 rounded-lg px-3 py-2 flex items-center justify-between text-[11px]">
              <span class="text-white/70 font-medium">Featured Tool :</span>
              <span class="text-[#06B6D4] font-bold">Text to PDF</span>
            </div>
          </div>
        </a>

        <!-- 2. Image Tools - Teal -->
        <a href="/tools?cat=Image" class="group relative rounded-xl overflow-hidden bg-[#19222b] border border-[#293847] hover:border-[#0D9488]/50 hover:-translate-y-1 transition-all duration-200 shadow-xl flex flex-col">
          <div class="p-6 bg-gradient-to-b from-[#0D9488] to-[#0F766E] flex flex-col justify-between h-[145px] text-white relative overflow-hidden">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center p-2">
                <img src="/assets/image-svgrepo-com.svg" class="w-full h-full object-contain brightness-0 invert" alt="Image Tools" />
              </div>
              <span class="text-[11px] font-semibold bg-white/25 px-2.5 py-1 rounded-full">2 tools</span>
            </div>
            <div class="flex items-end justify-between">
              <div>
                <h3 class="font-bold text-base leading-tight">Image Tools</h3>
                <p class="text-[12px] text-white/85 mt-0.5">Solve Your Image Problems</p>
              </div>
              <span class="text-white/80 group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
          <div class="p-3 bg-[#19222b]">
            <div class="bg-[#0D9488]/15 rounded-lg px-3 py-2 flex items-center justify-between text-[11px]">
              <span class="text-white/70 font-medium">Featured Tool :</span>
              <span class="text-[#0D9488] font-bold">Image to PDF</span>
            </div>
          </div>
        </a>

        <!-- 3. Convert Tools - Coral Pink -->
        <a href="/tools?cat=Document Converter" class="group relative rounded-xl overflow-hidden bg-[#19222b] border border-[#293847] hover:border-[#F472B6]/50 hover:-translate-y-1 transition-all duration-200 shadow-xl flex flex-col">
          <div class="p-6 bg-gradient-to-b from-[#F472B6] to-[#EC4899] flex flex-col justify-between h-[145px] text-white relative overflow-hidden">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center p-2">
                <img src="/assets/multiple-documents-files-svgrepo-com.svg" class="w-full h-full object-contain brightness-0 invert" alt="Convert Tools" />
              </div>
              <span class="text-[11px] font-semibold bg-white/25 px-2.5 py-1 rounded-full">7 tools</span>
            </div>
            <div class="flex items-end justify-between">
              <div>
                <h3 class="font-bold text-base leading-tight">Convert Tools</h3>
                <p class="text-[12px] text-white/85 mt-0.5">Solve Your File Problems</p>
              </div>
              <span class="text-white/80 group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
          <div class="p-3 bg-[#19222b]">
            <div class="bg-[#F472B6]/15 rounded-lg px-3 py-2 flex items-center justify-between text-[11px]">
              <span class="text-white/70 font-medium">Featured Tool :</span>
              <span class="text-[#F472B6] font-bold">JPG to Word</span>
            </div>
          </div>
        </a>

        <!-- 4. All Tools - Indigo -->
        <a href="/tools" class="group relative rounded-xl overflow-hidden bg-[#19222b] border border-[#293847] hover:border-[#6366F1]/50 hover:-translate-y-1 transition-all duration-200 shadow-xl flex flex-col">
          <div class="p-6 bg-gradient-to-b from-[#6366F1] to-[#4F46E5] flex flex-col justify-between h-[145px] text-white relative overflow-hidden">
            <div class="flex items-center justify-between">
              <div class="w-9 h-9 rounded-lg bg-white/20 flex items-center justify-center p-2">
                <img src="/assets/grid-layout-svgrepo-com-3.svg" class="w-full h-full object-contain brightness-0 invert" alt="All Tools" />
              </div>
              <span class="text-[11px] font-semibold bg-white/25 px-2.5 py-1 rounded-full">14 utils</span>
            </div>
            <div class="flex items-end justify-between">
              <div>
                <h3 class="font-bold text-base leading-tight">All Tools</h3>
                <p class="text-[12px] text-white/85 mt-0.5">Explore Complete Directory</p>
              </div>
              <span class="text-white/80 group-hover:translate-x-1 transition-transform">→</span>
            </div>
          </div>
          <div class="p-3 bg-[#19222b]">
            <div class="bg-[#6366F1]/15 rounded-lg px-3 py-2 flex items-center justify-between text-[11px]">
              <span class="text-white/70 font-medium">Featured Tool :</span>
              <span class="text-[#6366F1] font-bold">All Utilities</span>
            </div>
          </div>
        </a>
      </section>

    </main>
  </div>

  <!-- TRUST SECTION WRAPPER (Centered with visible margins, approx 88% width max 1200px, rounded-3xl / 24px) -->
  <div class="bg-[#171717] pt-12 pb-12 px-6">
    <!-- SECTION 4 — TRUST / STATISTICS SECTION -->
    <section class="max-w-[1200px] w-[88%] mx-auto bg-[#242424] border border-[#2E2E2E] rounded-[24px] px-8 py-6 flex items-center justify-between shadow-lg">
      <!-- Item 1: Fast Conversion -->
      <div class="flex items-center gap-3.5 flex-1 justify-center">
        <div class="w-10 h-10 rounded-lg bg-transparent flex items-center justify-center shrink-0">
          <img src="/assets/zap-svgrepo-com.svg" class="w-full h-full object-contain brightness-0 invert" alt="Fast Conversion" />
        </div>
        <div class="flex flex-col">
          <span class="text-[13px] font-bold text-[#1b8ae6] leading-tight">Fast Conversion</span>
        </div>
      </div>
      <div class="w-[1px] h-8 bg-white/15"></div>

      <!-- Item 2: Secure Processing -->
      <div class="flex items-center gap-3.5 flex-1 justify-center">
        <div class="w-10 h-10 rounded-lg bg-transparent flex items-center justify-center shrink-0">
          <img src="/assets/shield-tick-svgrepo-com.svg" class="w-full h-full object-contain brightness-0 invert" alt="Secure Processing" />
        </div>
        <div class="flex flex-col">
          <span class="text-[13px] font-bold text-[#1b8ae6] leading-tight">Secure Processing</span>
        </div>
      </div>
      <div class="w-[1px] h-8 bg-white/15"></div>

      <!-- Item 3: Multiple Formats -->
      <div class="flex items-center gap-3.5 flex-1 justify-center">
        <div class="w-10 h-10 rounded-lg bg-transparent flex items-center justify-center shrink-0">
          <img src="/assets/multiple-file-svgrepo-com.svg" class="w-full h-full object-contain brightness-0 invert" alt="Multiple Formats" />
        </div>
        <div class="flex flex-col">
          <span class="text-[13px] font-bold text-[#1b8ae6] leading-tight">Multiple Formats</span>
        </div>
      </div>
      <div class="w-[1px] h-8 bg-white/15"></div>

      <!-- Item 4: Free to Use -->
      <div class="flex items-center gap-3.5 flex-1 justify-center">
        <div class="w-10 h-10 rounded-lg bg-transparent flex items-center justify-center shrink-0">
          <img src="/assets/gift-svgrepo-com.svg" class="w-full h-full object-contain brightness-0 invert" alt="Free to Use" />
        </div>
        <div class="flex flex-col">
          <span class="text-[13px] font-bold text-[#1b8ae6] leading-tight">Free to Use</span>
        </div>
      </div>
    </section>
  </div>

  <!-- SECTION 5 — MOST POPULAR TOOLS (bg #242424 with abstract waves) -->
  <section class="bg-[#242424] relative overflow-hidden py-16 border-b border-[#2E2E2E]">
    <!-- Abstract Wave Background SVG -->
    <div class="absolute inset-0 pointer-events-none opacity-20 overflow-hidden">
      <svg class="w-full h-full text-[#334659]" viewBox="0 0 1440 600" fill="none" preserveAspectRatio="none">
        <path d="M-100 100 C 300 200, 500 0, 900 150 C 1300 300, 1500 100, 1600 200" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 250 C 400 350, 600 150, 1000 300 C 1400 450, 1500 250, 1600 350" stroke="currentColor" stroke-width="1.5" />
        <path d="M-100 400 C 350 500, 700 300, 1100 450 C 1450 550, 1550 350, 1650 500" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </div>

    <div class="max-w-[1200px] mx-auto px-6 relative z-10 space-y-8">
      <!-- Section Heading & Subtitle -->
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-3xl md:text-[38px] font-bold tracking-tight text-white">Popular Tools</h2>
        <p class="text-sm text-white/90">
          Fast, free, and secure. No catch.
        </p>
      </div>

      <!-- Category Selector Tabs -->
      <div class="flex items-center justify-center gap-1.5 bg-black/20 p-1.5 rounded-full max-w-fit mx-auto shadow-inner">
        <button class="hub-tab active px-5 py-2 rounded-full text-xs font-semibold bg-[#1b8ae6] text-white transition-all shadow-sm" data-cat="all">
          All Tools
        </button>
        <button class="hub-tab px-5 py-2 rounded-full text-xs font-semibold text-[#7f8c99] hover:text-white transition-all" data-cat="PDF Tools">
          PDF Tools
        </button>
        <button class="hub-tab px-5 py-2 rounded-full text-xs font-semibold text-[#7f8c99] hover:text-white transition-all" data-cat="Image Tools">
          Image Tools
        </button>
        <button class="hub-tab px-5 py-2 rounded-full text-xs font-semibold text-[#7f8c99] hover:text-white transition-all" data-cat="Document Converter">
          Convert Tools
        </button>
      </div>

      <!-- Tool Grid (4 columns, horizontal compact cards) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="hub-grid">
        {TOOLS.map((tool, index) => (
          <a
            href={`/tools/${tool.slug}`}
            class={`hub-card group bg-[#171717] rounded-xl p-4 border border-white/[0.03] hover:border-[#1b8ae6]/35 hover:bg-[#243240] hover:-translate-y-0.5 transition-all flex flex-col justify-between ${index >= 12 ? 'hidden extra-tool' : ''}`}
            data-category={tool.category}
            data-name={tool.name.toLowerCase()}
            data-desc={tool.shortDesc.toLowerCase()}
          >
            <div class="flex items-start gap-3">
              <div class="w-[34px] h-[34px] rounded-lg bg-[#3a4756] flex items-center justify-center shrink-0">
                <ToolIcon {tool} size="sm" />
              </div>
              <div class="min-w-0 flex-1">
                <h3 class="text-[13px] font-bold text-white transition-colors truncate">{tool.name}</h3>
                <span class={`text-[10px] font-medium block mt-0.5 ${tool.category === 'PDF Tools' ? 'text-[#ff5c7c]' : tool.category === 'Image Tools' ? 'text-[#4fd8d0]' : 'text-[#a78bfa]'}`}>{tool.category}</span>
              </div>
            </div>
            <p class="text-[12px] text-[#7f8c99] leading-snug line-clamp-2 mt-3">{tool.shortDesc}</p>
          </a>
        ))}
      </div>

      <!-- Empty State -->
      <div id="hub-empty" class="hidden text-center py-16">
        <h3 class="text-base font-bold text-white">No matching document utilities found</h3>
        <p class="text-xs text-[#7f8c99] mt-1">Try searching with a different keyword or category filter.</p>
      </div>

      <!-- Bottom All Tools Button -->
      <div class="flex justify-center pt-6">
        <button id="reveal-all-btn" class="px-10 py-3 rounded-lg border border-[#1b8ae6] text-xs font-semibold text-[#1b8ae6] hover:bg-[#1b8ae6]/12 transition-all shadow-[0_0_24px_rgba(27,138,230,0.35)]">
          <span id="reveal-btn-text">All Tools</span>
        </button>
      </div>
    </div>
  </section>

  <!-- OTHER SECTIONS (Why Choose, FAQ, Footer kept intact as per rules) -->
  <main class="max-w-[1440px] mx-auto px-10 py-16 space-y-16">
    <!-- SECTION — WHY CHOOSE CIPHERPDF -->
    <section class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-8 lg:p-12 shadow-xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7 space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#171717] border border-[#2E2E2E] text-[10px] font-mono text-[#6E96FF] uppercase tracking-wider font-semibold">
            Security & Privacy Guarantee
          </div>
          <h2 class="text-3xl font-semibold tracking-tight text-[#EDEDED]">Why Choose CipherPDF?</h2>
          <p class="text-xs sm:text-sm text-[#EDEDED] leading-relaxed">
            Zero remote server uploads. All conversions, extractions, and document processing happen entirely within your local browser sandbox using modern client-side WebAssembly and JS engines.
          </p>
          <div class="grid grid-cols-2 gap-4 pt-2">
            <div class="flex items-center gap-2 text-xs text-[#EDEDED]">
              <span class="text-emerald-400 font-bold">✓</span> 100% Client-Side Processing
            </div>
            <div class="flex items-center gap-2 text-xs text-[#EDEDED]">
              <span class="text-emerald-400 font-bold">✓</span> No Registration Required
            </div>
            <div class="flex items-center gap-2 text-xs text-[#EDEDED]">
              <span class="text-emerald-400 font-bold">✓</span> Instant Lightning Speed
            </div>
            <div class="flex items-center gap-2 text-xs text-[#EDEDED]">
              <span class="text-emerald-400 font-bold">✓</span> Complete Data Privacy
            </div>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="bg-[#242424] rounded-xl overflow-hidden flex items-center justify-center shadow-inner p-4">
            <img src="/trust-workflow.webp" alt="Document Conversion Workflow" class="w-full h-auto object-contain" />
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION — FAQ -->
    <section class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-8 lg:p-12 space-y-6">
      <div class="text-center space-y-2">
        <h2 class="text-3xl font-semibold tracking-tight text-[#EDEDED]">Frequently Asked Questions</h2>
        <p class="text-xs text-[#EDEDED]">Everything you need to know about secure browser-based document utilities.</p>
      </div>

      <div class="space-y-3 max-w-3xl mx-auto">
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>What is CipherPDF?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>Is it completely free to use?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>Do I need to sign up or create an account?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>Is my document data secure and private?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
        <div class="border border-[#2E2E2E] rounded-xl bg-[#171717] p-4 flex items-center justify-between text-xs font-medium text-[#EDEDED] cursor-pointer hover:border-[#4778F5] transition-colors">
          <span>Can I use these utilities on mobile devices?</span>
          <span class="text-[#A3A3A3]">⌄</span>
        </div>
      </div>
    </section>

    <!-- DEVELOPED BY MAYANK SHARMA -->
    <section class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-xl h-16 px-6 flex items-center justify-center gap-3 shadow-md">
      <div class="w-7 h-7 rounded-lg bg-[#4778F5] text-white font-mono text-xs font-bold flex items-center justify-center">M</div>
      <span class="text-xs font-medium text-[#EDEDED]">Developed by Mayank Sharma</span>
    </section>
  </main>

  <!-- FOOTER -->
  <Footer />

  <!-- SECTION — BACK TO TOP BUTTON -->
  <button
    id="back-to-top"
    aria-label="Back to top"
    class="fixed bottom-8 right-8 z-50 w-11 h-11 rounded-full bg-[#1F1F1F] border border-[#2E2E2E] text-[#EDEDED] shadow-2xl flex items-center justify-center opacity-0 pointer-events-none hover:bg-[#4778F5] hover:border-[#4778F5] transition-all duration-300"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
    </svg>
  </button>

  <script>
    const searchInput = document.getElementById('hero-search') as HTMLInputElement;
    const hubTabs = document.querySelectorAll('.hub-tab');
    const hubCards = document.querySelectorAll('.hub-card');
    const hubEmpty = document.getElementById('hub-empty');
    const revealAllBtn = document.getElementById('reveal-all-btn');
    const revealBtnText = document.getElementById('reveal-btn-text');
    const backToTopBtn = document.getElementById('back-to-top');

    let activeCat = 'all';
    let queryText = '';
    let allRevealed = false;

    function filterHub() {
      let count = 0;
      hubCards.forEach((card) => {
        const el = card as HTMLElement;
        const cat = el.getAttribute('data-category');
        const name = el.getAttribute('data-name') || '';
        const desc = el.getAttribute('data-desc') || '';

        const matchCat = activeCat === 'all' || cat === activeCat;
        const matchQuery = !queryText || name.includes(queryText) || desc.includes(queryText);

        if (matchCat && matchQuery) {
          // If not all revealed and cat is 'all', only show first 10 unless filtered by specific cat or query
          if (activeCat === 'all' && !queryText && !allRevealed && el.classList.contains('extra-tool')) {
            el.style.display = 'none';
          } else {
            el.style.display = 'flex';
            count++;
          }
        } else {
          el.style.display = 'none';
        }
      });

      if (hubEmpty) {
        if (count === 0) {
          hubEmpty.classList.remove('hidden');
        } else {
          hubEmpty.classList.add('hidden');
        }
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        queryText = (e.target as HTMLInputElement).value.toLowerCase();
        filterHub();
      });
    }

    hubTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        hubTabs.forEach(t => {
          t.classList.remove('bg-[#4778F5]', 'text-white', 'shadow-sm');
          t.classList.add('bg-[#1F1F1F]', 'border', 'border-[#2E2E2E]', 'text-[#A3A3A3]');
        });
        tab.classList.remove('bg-[#1F1F1F]', 'border', 'border-[#2E2E2E]', 'text-[#A3A3A3]');
        tab.classList.add('bg-[#4778F5]', 'text-white', 'shadow-sm');

        activeCat = tab.getAttribute('data-cat') || 'all';
        filterHub();
      });
    });

    if (revealAllBtn) {
      revealAllBtn.addEventListener('click', () => {
        allRevealed = !allRevealed;
        if (allRevealed) {
          if (revealBtnText) revealBtnText.textContent = 'Show Less';
        } else {
          if (revealBtnText) revealBtnText.textContent = 'All Tools';
        }
        filterHub();
      });
    }

    // Back to Top functionality
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTopBtn?.classList.remove('opacity-0', 'pointer-events-none');
        backToTopBtn?.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        backToTopBtn?.classList.add('opacity-0', 'pointer-events-none');
        backToTopBtn?.classList.remove('opacity-100', 'pointer-events-auto');
      }
    });

    backToTopBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  </script>
</Layout>
