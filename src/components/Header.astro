---
import { TOOLS } from '../data/tools';
import ToolIcon from './ToolIcon.astro';

const pdfTools = TOOLS.filter(t => t.category === 'PDF Tools');
const imageTools = TOOLS.filter(t => t.category === 'Image Tools');
const convertTools = TOOLS.filter(t => t.category === 'Document Converter');
const allTools = TOOLS;

// Helper function to split tools into two columns
function splitIntoColumns(tools: typeof TOOLS) {
  const mid = Math.ceil(tools.length / 2);
  return {
    left: tools.slice(0, mid),
    right: tools.slice(mid)
  };
}

const pdfCols = splitIntoColumns(pdfTools);
const imageCols = splitIntoColumns(imageTools);
const convertCols = splitIntoColumns(convertTools);
const allToolsCols = splitIntoColumns(allTools);
---
<header class="sticky top-0 z-50 bg-[#171717]/95 backdrop-blur-md border-b border-[#2E2E2E] shadow-sm">
  <div class="max-w-[1440px] mx-auto px-10 h-20 flex items-center justify-between">
    <!-- Logo & Brand -->
    <div class="flex items-center gap-10">
      <a href="/" class="flex items-center gap-3 group">
        <div class="w-10 h-10 rounded-xl bg-[#4778F5] text-white flex items-center justify-center font-mono font-bold text-base shadow-lg group-hover:scale-105 transition-transform">CP</div>
        <div class="flex flex-col">
          <span class="text-[#EDEDED] font-semibold tracking-tight text-lg leading-tight">CipherPDF</span>
          <span class="text-[10px] font-mono text-[#6E96FF] uppercase tracking-widest font-semibold">Secure Utilities</span>
        </div>
      </a>

      <!-- Nav Links with Dropdowns -->
      <nav class="hidden lg:flex items-center gap-2">
        <!-- 1. PDF Tools -->
        <div class="relative group/dropdown">
          <button class="nav-btn px-4 py-2 rounded-full text-sm font-medium text-[#A3A3A3] hover:text-[#EDEDED] hover:bg-[#1F1F1F] transition-colors flex items-center gap-1.5">
            <span>PDF Tools</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/dropdown:rotate-180 text-[#A3A3A3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 pt-2 w-[600px] opacity-0 translate-y-2 pointer-events-none group-hover/dropdown:opacity-100 group-hover/dropdown:translate-y-0 group-hover/dropdown:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-4 shadow-2xl">
              <div class="px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider text-purple-400 font-bold border-b border-[#2E2E2E] mb-3">PDF Utilities ({pdfTools.length})</div>
              <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                <!-- Left Column -->
                <div class="space-y-2">
                  {pdfCols.left.map(tool => (
                    <a href={`/tools/${tool.slug}`} class="flex items-start gap-3 p-2 rounded-xl hover:bg-[#2A2A2A] transition-colors group/item">
                      <ToolIcon {tool} size="sm" />
                      <div class="min-w-0 flex-1">
                        <div class="text-xs font-semibold text-[#EDEDED] group-hover/item:text-purple-400 transition-colors">{tool.name}</div>
                        <div class="text-[10px] text-[#FFFFFF] leading-tight">{tool.shortDesc}</div>
                      </div>
                    </a>
                  ))}
                </div>
                <!-- Right Column -->
                <div class="space-y-2">
                  {pdfCols.right.map(tool => (
                    <a href={`/tools/${tool.slug}`} class="flex items-start gap-3 p-2 rounded-xl hover:bg-[#2A2A2A] transition-colors group/item">
                      <ToolIcon {tool} size="sm" />
                      <div class="min-w-0 flex-1">
                        <div class="text-xs font-semibold text-[#EDEDED] group-hover/item:text-purple-400 transition-colors">{tool.name}</div>
                        <div class="text-[10px] text-[#FFFFFF] leading-tight">{tool.shortDesc}</div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Image Tools -->
        <div class="relative group/dropdown">
          <button class="nav-btn px-4 py-2 rounded-full text-sm font-medium text-[#A3A3A3] hover:text-[#EDEDED] hover:bg-[#1F1F1F] transition-colors flex items-center gap-1.5">
            <span>Image Tools</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/dropdown:rotate-180 text-[#A3A3A3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 pt-2 w-[600px] opacity-0 translate-y-2 pointer-events-none group-hover/dropdown:opacity-100 group-hover/dropdown:translate-y-0 group-hover/dropdown:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-4 shadow-2xl">
              <div class="px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider text-[#6E96FF] font-bold border-b border-[#2E2E2E] mb-3">Image Utilities ({imageTools.length})</div>
              <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                <!-- Left Column -->
                <div class="space-y-2">
                  {imageCols.left.map(tool => (
                    <a href={`/tools/${tool.slug}`} class="flex items-start gap-3 p-2 rounded-xl hover:bg-[#2A2A2A] transition-colors group/item">
                      <ToolIcon {tool} size="sm" />
                      <div class="min-w-0 flex-1">
                        <div class="text-xs font-semibold text-[#EDEDED] group-hover/item:text-[#6E96FF] transition-colors">{tool.name}</div>
                        <div class="text-[10px] text-[#FFFFFF] leading-tight">{tool.shortDesc}</div>
                      </div>
                    </a>
                  ))}
                </div>
                <!-- Right Column -->
                <div class="space-y-2">
                  {imageCols.right.map(tool => (
                    <a href={`/tools/${tool.slug}`} class="flex items-start gap-3 p-2 rounded-xl hover:bg-[#2A2A2A] transition-colors group/item">
                      <ToolIcon {tool} size="sm" />
                      <div class="min-w-0 flex-1">
                        <div class="text-xs font-semibold text-[#EDEDED] group-hover/item:text-[#6E96FF] transition-colors">{tool.name}</div>
                        <div class="text-[10px] text-[#FFFFFF] leading-tight">{tool.shortDesc}</div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Convert Tools -->
        <div class="relative group/dropdown">
          <button class="nav-btn px-4 py-2 rounded-full text-sm font-medium text-[#A3A3A3] hover:text-[#EDEDED] hover:bg-[#1F1F1F] transition-colors flex items-center gap-1.5">
            <span>Convert Tools</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/dropdown:rotate-180 text-[#A3A3A3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 pt-2 w-[600px] opacity-0 translate-y-2 pointer-events-none group-hover/dropdown:opacity-100 group-hover/dropdown:translate-y-0 group-hover/dropdown:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-4 shadow-2xl">
              <div class="px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider text-[#4778F5] font-bold border-b border-[#2E2E2E] mb-3">Convert Utilities ({convertTools.length})</div>
              <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                <!-- Left Column -->
                <div class="space-y-2">
                  {convertCols.left.map(tool => (
                    <a href={`/tools/${tool.slug}`} class="flex items-start gap-3 p-2 rounded-xl hover:bg-[#2A2A2A] transition-colors group/item">
                      <ToolIcon {tool} size="sm" />
                      <div class="min-w-0 flex-1">
                        <div class="text-xs font-semibold text-[#EDEDED] group-hover/item:text-[#6E96FF] transition-colors">{tool.name}</div>
                        <div class="text-[10px] text-[#FFFFFF] leading-tight">{tool.shortDesc}</div>
                      </div>
                    </a>
                  ))}
                </div>
                <!-- Right Column -->
                <div class="space-y-2">
                  {convertCols.right.map(tool => (
                    <a href={`/tools/${tool.slug}`} class="flex items-start gap-3 p-2 rounded-xl hover:bg-[#2A2A2A] transition-colors group/item">
                      <ToolIcon {tool} size="sm" />
                      <div class="min-w-0 flex-1">
                        <div class="text-xs font-semibold text-[#EDEDED] group-hover/item:text-[#6E96FF] transition-colors">{tool.name}</div>
                        <div class="text-[10px] text-[#FFFFFF] leading-tight">{tool.shortDesc}</div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 4. All Tools -->
        <div class="relative group/dropdown">
          <button class="nav-btn px-4 py-2 rounded-full text-sm font-medium text-[#A3A3A3] hover:text-[#EDEDED] hover:bg-[#1F1F1F] transition-colors flex items-center gap-1.5">
            <span>All Tools</span>
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover/dropdown:rotate-180 text-[#A3A3A3]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div class="absolute top-full left-0 pt-2 w-[600px] opacity-0 translate-y-2 pointer-events-none group-hover/dropdown:opacity-100 group-hover/dropdown:translate-y-0 group-hover/dropdown:pointer-events-auto transition-all duration-200 z-50">
            <div class="bg-[#1F1F1F] border border-[#2E2E2E] rounded-2xl p-4 shadow-2xl">
              <div class="px-3 py-1.5 text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-bold border-b border-[#2E2E2E] mb-3">All Utilities ({allTools.length})</div>
              <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                <!-- Left Column -->
                <div class="space-y-2">
                  {allToolsCols.left.map(tool => (
                    <a href={`/tools/${tool.slug}`} class="flex items-start gap-3 p-2 rounded-xl hover:bg-[#2A2A2A] transition-colors group/item">
                      <ToolIcon {tool} size="sm" />
                      <div class="min-w-0 flex-1">
                        <div class="text-xs font-semibold text-[#EDEDED] group-hover/item:text-emerald-400 transition-colors">{tool.name}</div>
                        <div class="text-[10px] text-[#FFFFFF] leading-tight">{tool.shortDesc}</div>
                      </div>
                    </a>
                  ))}
                </div>
                <!-- Right Column -->
                <div class="space-y-2">
                  {allToolsCols.right.map(tool => (
                    <a href={`/tools/${tool.slug}`} class="flex items-start gap-3 p-2 rounded-xl hover:bg-[#2A2A2A] transition-colors group/item">
                      <ToolIcon {tool} size="sm" />
                      <div class="min-w-0 flex-1">
                        <div class="text-xs font-semibold text-[#EDEDED] group-hover/item:text-emerald-400 transition-colors">{tool.name}</div>
                        <div class="text-[10px] text-[#FFFFFF] leading-tight">{tool.shortDesc}</div>
                      </div>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </nav>
    </div>

    <!-- Right Actions: Dark Mode Toggle, Hamburger -->
    <div class="flex items-center gap-4">
      <!-- Theme Toggle -->
      <button aria-label="Toggle Theme" class="w-10 h-10 rounded-xl bg-[#1F1F1F] border border-[#2E2E2E] text-[#EDEDED] flex items-center justify-center hover:bg-[#2A2A2A] transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </button>

      <!-- Hamburger Button -->
      <button aria-label="Menu" class="lg:hidden w-10 h-10 rounded-xl bg-[#1F1F1F] border border-[#2E2E2E] text-[#EDEDED] flex items-center justify-center hover:bg-[#2A2A2A] transition-colors">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>
