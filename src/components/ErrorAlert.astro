---
// Error Alert Component for displaying user-facing error messages
// Usage: <ErrorAlert error={error} onDismiss={() => setError(null)} />

interface Props {
  error?: {
    message: string;
    userMessage?: string;
    code?: string;
  } | null;
  onDismiss?: () => void;
  autoClose?: number; // milliseconds
}

const { error, onDismiss, autoClose = 5000 } = Astro.props as Props;

if (!error) {
  // Return empty fragment if no error
}
---

{error && (
  <div
    class="fixed top-4 right-4 z-50 max-w-md animate-in fade-in slide-in-from-right-4 duration-300"
    role="alert"
    aria-live="assertive"
  >
    <div class="bg-red-50 border border-red-200 rounded-xl shadow-lg overflow-hidden">
      <div class="p-4 flex gap-3">
        <!-- Error Icon -->
        <div class="flex-shrink-0 flex items-start pt-0.5">
          <svg
            class="h-5 w-5 text-red-600"
            fill="currentColor"
            viewBox="0 0 20 20"
          >
            <path
              fill-rule="evenodd"
              d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
              clip-rule="evenodd"
            />
          </svg>
        </div>

        <!-- Error Content -->
        <div class="flex-1 min-w-0">
          <h3 class="text-sm font-semibold text-red-800">
            {error.userMessage || 'An error occurred'}
          </h3>
          {error.code && (
            <p class="mt-1 text-xs text-red-600 font-mono">
              Error Code: {error.code}
            </p>
          )}
        </div>

        <!-- Dismiss Button -->
        {onDismiss && (
          <button
            onClick={onDismiss}
            class="flex-shrink-0 inline-flex text-red-400 hover:text-red-600 transition-colors"
            aria-label="Dismiss error"
          >
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        )}
      </div>
    </div>
  </div>
)}

<style>
  @keyframes slide-in-from-right-4 {
    from {
      transform: translateX(1rem);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .animate-in {
    animation: fade-in 0.3s ease-out, slide-in-from-right-4 0.3s ease-out;
  }
</style>

<script>
  // Auto-close error after specified duration
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupAutoClose);
  } else {
    setupAutoClose();
  }

  function setupAutoClose() {
    const alerts = document.querySelectorAll('[role="alert"]');
    alerts.forEach((alert) => {
      const autoCloseAttr = alert.getAttribute('data-auto-close');
      if (autoCloseAttr) {
        const duration = parseInt(autoCloseAttr);
        setTimeout(() => {
          alert.remove();
        }, duration);
      }
    });
  }
</script>
