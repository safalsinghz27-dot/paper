---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { tool, size = 'md' } = Astro.props;

// Size variants: tile size, radius, glyph size
const sizeMap = {
  sm: { tile: 'w-8 h-8', radius: 'rounded-[9px]', glyph: 'w-[18px] h-[18px]' }, // 32x32, radius 9px, glyph 18px (mega-menu)
  md: { tile: 'w-11 h-11', radius: 'rounded-[12px]', glyph: 'w-[22px] h-[22px]' }, // 44x44, radius 12px, glyph 22px (mobile cards)
  lg: { tile: 'w-12 h-12', radius: 'rounded-[14px]', glyph: 'w-6 h-6' }, // 48x48, radius 14px, glyph 24px (desktop cards)
  xl: { tile: 'w-16 h-16', radius: 'rounded-[18px]', glyph: 'w-8 h-8' }, // 64x64, radius 18px, glyph 32px (tool page header)
};

// Get category identifier for CSS class
const getCategoryClass = (category: string): string => {
  switch (category) {
    case 'PDF Tools':
      return 'icon-pdf';
    case 'Image Tools':
      return 'icon-image';
    case 'Document Converter':
      return 'icon-convert';
    default:
      return 'icon-convert';
  }
};

const categoryClass = getCategoryClass(tool.category);
const sizeConfig = sizeMap[size] || sizeMap.md;
---

<div
  class={`${sizeConfig.tile} ${sizeConfig.radius} flex items-center justify-center shrink-0 transition-transform will-change-transform bg-white/8 ring-1 ring-inset ring-white/16`}
  aria-hidden="true"
>
  <img
    src={`/icons/${tool.icon}`}
    alt=""
    class={`${sizeConfig.glyph} flex-shrink-0 ${categoryClass}`}
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  /* Dark theme (default) - Lucide icons are naturally dark-colored, so recolor to category colors */
  .icon-pdf {
    filter: brightness(0) saturate(100%) invert(68%) sepia(82%) saturate(472%) hue-rotate(0deg);
  }

  .icon-image {
    filter: brightness(0) saturate(100%) invert(70%) sepia(58%) saturate(1500%) hue-rotate(280deg);
  }

  .icon-convert {
    filter: brightness(0) saturate(100%) invert(60%) sepia(95%) saturate(800%) hue-rotate(210deg);
  }

  /* Light theme backgrounds */
  @media (prefers-color-scheme: light) {
    div {
      background-color: #F1F4FB;
      border: 1px solid #E4E8F5;
    }

    /* Adjust filters for light theme - different base colors needed */
    .icon-pdf {
      filter: brightness(0) saturate(100%) invert(29%) sepia(74%) saturate(1200%) hue-rotate(352deg);
    }

    .icon-image {
      filter: brightness(0) saturate(100%) invert(22%) sepia(78%) saturate(1700%) hue-rotate(260deg);
    }

    .icon-convert {
      filter: brightness(0) saturate(100%) invert(18%) sepia(84%) saturate(1600%) hue-rotate(220deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    div {
      transition: none !important;
    }
  }
</style>
