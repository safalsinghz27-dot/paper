---
import type { Tool } from '../data/tools';

interface Props {
  tool: Tool;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { tool, size = 'md' } = Astro.props;

// Size variants: tile size, radius, glyph size
const sizeMap = {
  sm: { tile: 'w-8 h-8', radius: 'rounded-[9px]', glyph: 'w-[22px] h-[22px]' }, // 32x32, radius 9px, glyph increased by ~25% (18px -> 22px)
  md: { tile: 'w-11 h-11', radius: 'rounded-[12px]', glyph: 'w-[28px] h-[28px]' }, // 44x44, radius 12px, glyph increased by ~25% (22px -> 28px)
  lg: { tile: 'w-12 h-12', radius: 'rounded-[14px]', glyph: 'w-[30px] h-[30px]' }, // 48x48, radius 14px, glyph increased by ~25% (24px -> 30px)
  xl: { tile: 'w-16 h-16', radius: 'rounded-[18px]', glyph: 'w-10 h-10' }, // 64x64, radius 18px, glyph increased by ~25% (32px -> 40px)
};

// Get category identifier for CSS class
const getCategoryClass = (category: string): string => {
  switch (category) {
    case 'PDF Tools':
      return 'icon-pdf';
    case 'Image Tools':
      return 'icon-image';
    case 'Document Converter':
      return 'icon-convert';
    default:
      return 'icon-convert';
  }
};

const categoryClass = getCategoryClass(tool.category);
const tileClass = tool.category === 'PDF Tools' ? 'tile-pdf' : tool.category === 'Image Tools' ? 'tile-image' : 'tile-convert';
const sizeConfig = sizeMap[size] || sizeMap.md;
---

<div
  class={`${sizeConfig.tile} ${sizeConfig.radius} flex items-center justify-center shrink-0 transition-transform will-change-transform bg-[rgba(36,36,36,0.5)] ${tileClass}`}
  aria-hidden="true"
>
  <img
    src={`/icons/${tool.icon}`}
    alt=""
    class={`${sizeConfig.glyph} flex-shrink-0 ${categoryClass}`}
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  /* Dark theme (default) - Lucide icons are naturally dark-colored, so recolor to category colors */
  .icon-pdf {
    filter: brightness(0) saturate(100%) invert(68%) sepia(82%) saturate(472%) hue-rotate(0deg);
  }

  .icon-image {
    filter: brightness(0) saturate(100%) invert(70%) sepia(58%) saturate(1500%) hue-rotate(280deg);
  }

  .icon-convert {
    filter: brightness(0) saturate(100%) invert(60%) sepia(95%) saturate(800%) hue-rotate(210deg);
  }

  /* Light theme container backgrounds (50% transparent color-matched) */
  html:not(.dark) .tile-pdf {
    background-color: rgba(217, 45, 51, 0.5) !important;
    border: none !important;
  }
  html:not(.dark) .tile-image {
    background-color: rgba(109, 74, 224, 0.5) !important;
    border: none !important;
  }
  html:not(.dark) .tile-convert {
    background-color: rgba(31, 87, 230, 0.5) !important;
    border: none !important;
  }

  /* Adjust filters for light theme */
  html:not(.dark) .icon-pdf {
    filter: brightness(0) saturate(100%) invert(29%) sepia(74%) saturate(1200%) hue-rotate(352deg);
  }

  html:not(.dark) .icon-image {
    filter: brightness(0) saturate(100%) invert(22%) sepia(78%) saturate(1700%) hue-rotate(260deg);
  }

  html:not(.dark) .icon-convert {
    filter: brightness(0) saturate(100%) invert(18%) sepia(84%) saturate(1600%) hue-rotate(220deg);
  }

  /* Fallback for prefers-color-scheme: light when .dark class is not present */
  @media (prefers-color-scheme: light) {
    :root:not(.dark) .tile-pdf, body:not(.dark) .tile-pdf {
      background-color: rgba(217, 45, 51, 0.5) !important;
      border: none !important;
    }
    :root:not(.dark) .tile-image, body:not(.dark) .tile-image {
      background-color: rgba(109, 74, 224, 0.5) !important;
      border: none !important;
    }
    :root:not(.dark) .tile-convert, body:not(.dark) .tile-convert {
      background-color: rgba(31, 87, 230, 0.5) !important;
      border: none !important;
    }
    :root:not(.dark) .icon-pdf, body:not(.dark) .icon-pdf {
      filter: brightness(0) saturate(100%) invert(29%) sepia(74%) saturate(1200%) hue-rotate(352deg);
    }
    :root:not(.dark) .icon-image, body:not(.dark) .icon-image {
      filter: brightness(0) saturate(100%) invert(22%) sepia(78%) saturate(1700%) hue-rotate(260deg);
    }
    :root:not(.dark) .icon-convert, body:not(.dark) .icon-convert {
      filter: brightness(0) saturate(100%) invert(18%) sepia(84%) saturate(1600%) hue-rotate(220deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    div {
      transition: none !important;
    }
  }
</style>
