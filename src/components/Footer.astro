---
---
<footer class="bg-[#171717] text-[#EDEDED] py-16 text-sm border-t border-[#2E2E2E]">
  <div class="max-w-[1440px] mx-auto px-10 grid grid-cols-1 md:grid-cols-5 gap-12">

    <!-- Brand Block -->
    <div class="md:col-span-1 space-y-4">
      <div class="flex items-center gap-3 font-semibold tracking-tight text-lg">
        <img src="/Picsart_26-11-04_17-36-51-176.png" alt="CipherPDF" class="w-8 h-8 object-contain group-hover:scale-105 transition-transform" />
        <span>CipherPDF</span>
      </div>
      <p class="text-[#FFFFFF] text-xs leading-relaxed">
        Secure client-side document converters for PDF, Word, Excel, CSV, text and image files in one place.
      </p>
      <div class="text-xs font-mono text-[#FFFFFF] space-y-1">
        <div>© {new Date().getFullYear()} CipherPDF</div>
        <div class="text-[#EDEDED]/80 font-medium">Developed by Mayank Sharma</div>
      </div>
    </div>

    <!-- PDF Tools Column -->
    <div>
      <div class="font-mono text-xs uppercase tracking-wider text-[#EDEDED] mb-4 font-bold">PDF Tools</div>
      <ul class="space-y-2.5 text-xs text-[#FFFFFF]">
        <li><a href="/tools/text-to-pdf" class="hover:text-[#EDEDED] transition-colors">Text to PDF</a></li>
        <li><a href="/tools/pdf-to-text" class="hover:text-[#EDEDED] transition-colors">PDF to Text</a></li>
        <li><a href="/tools/pdf-to-csv" class="hover:text-[#EDEDED] transition-colors">PDF to CSV</a></li>
        <li><a href="/tools/pdf-to-html" class="hover:text-[#EDEDED] transition-colors">PDF to HTML</a></li>
        <li><a href="/tools/pdf-to-excel" class="hover:text-[#EDEDED] transition-colors">PDF to Excel</a></li>
      </ul>
    </div>

    <!-- Image Tools & Convert Tools Column -->
    <div>
      <div class="font-mono text-xs uppercase tracking-wider text-[#EDEDED] mb-4 font-bold">Image Tools</div>
      <ul class="space-y-2.5 text-xs text-[#FFFFFF] mb-6">
        <li><a href="/tools/image-to-pdf" class="hover:text-[#EDEDED] transition-colors">Image to PDF</a></li>
        <li><a href="/tools/text-to-image" class="hover:text-[#EDEDED] transition-colors">Text to Image</a></li>
      </ul>
      <div class="font-mono text-xs uppercase tracking-wider text-[#EDEDED] mb-4 font-bold">Convert Tools</div>
      <ul class="space-y-2.5 text-xs text-[#FFFFFF]">
        <li><a href="/tools/jpg-to-word" class="hover:text-[#EDEDED] transition-colors">JPG to Word</a></li>
        <li><a href="/tools/text-to-word" class="hover:text-[#EDEDED] transition-colors">Text to Word</a></li>
        <li><a href="/tools/excel-to-csv" class="hover:text-[#EDEDED] transition-colors">Excel to CSV</a></li>
        <li><a href="/tools/word-to-excel" class="hover:text-[#EDEDED] transition-colors">Word to Excel</a></li>
      </ul>
    </div>

    <!-- Navigation Links / Legal -->
    <div>
      <div class="font-mono text-xs uppercase tracking-wider text-[#EDEDED] mb-4 font-bold">Navigation</div>
      <ul class="space-y-2.5 text-xs text-[#FFFFFF]">
        <li><a href="/tools" class="hover:text-[#EDEDED] transition-colors">All Tools Directory</a></li>
        <li><a href="/privacy" class="hover:text-[#EDEDED] transition-colors">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-[#EDEDED] transition-colors">Terms of Service</a></li>
        <li><a href="/data-handling" class="hover:text-[#EDEDED] transition-colors">Data & Security</a></li>
      </ul>
    </div>

    <!-- Socials & Support -->
    <div>
      <div class="font-mono text-xs uppercase tracking-wider text-[#EDEDED] mb-4 font-bold">Connect</div>
      <div class="flex items-center gap-3 mb-6">
        <a href="https://instagram.com" target="_blank" rel="noreferrer" class="w-9 h-9 rounded-xl bg-[#1F1F1F] border border-[#2E2E2E] text-[#FFFFFF] hover:text-[#EDEDED] hover:border-[#4778F5] flex items-center justify-center transition-all" aria-label="Instagram">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
        <a href="https://facebook.com" target="_blank" rel="noreferrer" class="w-9 h-9 rounded-xl bg-[#1F1F1F] border border-[#2E2E2E] text-[#FFFFFF] hover:text-[#EDEDED] hover:border-[#4778F5] flex items-center justify-center transition-all" aria-label="Facebook">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.378 14.5 5 15.5 5H18V0h-3.808C10.59 0 9 1.581 9 4.75V8z"/></svg>
        </a>
      </div>
      <p class="text-xs text-[#FFFFFF]">
        Support: <a href="mailto:support@cipherpdf.com" class="text-[#4778F5] hover:underline">support@cipherpdf.com</a>
      </p>
    </div>

  </div>
  <div class="max-w-[1440px] mx-auto px-10 mt-12 pt-6 border-t border-[#2E2E2E] flex flex-col sm:flex-row items-center justify-between text-[11px] text-[#FFFFFF]">
    <div>© {new Date().getFullYear()} CipherPDF. Developed by Mayank Sharma.</div>
    <div class="flex items-center gap-4 mt-2 sm:mt-0">
      <a href="/privacy" class="hover:text-[#EDEDED]">Privacy</a>
      <a href="/terms" class="hover:text-[#EDEDED]">Terms</a>
      <a href="/data-handling" class="hover:text-[#EDEDED]">Security</a>
    </div>
  </div>
</footer>
