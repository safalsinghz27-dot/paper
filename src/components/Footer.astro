---
---
<footer class="bg-[#172033] text-white py-16 text-sm">
  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 md:grid-cols-5 gap-12">

    <!-- Brand Block -->
    <div class="md:col-span-1 space-y-4">
      <div class="flex items-center gap-3 font-semibold tracking-tight text-lg">
        <div class="w-8 h-8 rounded-xl bg-[#4778F5] text-white flex items-center justify-center font-mono text-xs font-bold">PR</div>
        <span>PaperRepair</span>
      </div>
      <p class="text-[#8f9bb3] text-xs leading-relaxed">
        Simple document converters for PDF, Word, Excel, CSV, text and image files in one place.
      </p>
      <div class="text-xs font-mono text-[#8f9bb3]">
        © {new Date().getFullYear()} PaperRepair
      </div>
    </div>

    <!-- PDF Tools Column -->
    <div>
      <div class="font-mono text-xs uppercase tracking-wider text-white mb-4 font-bold">PDF Tools</div>
      <ul class="space-y-2.5 text-xs text-[#8f9bb3]">
        <li><a href="/tools/text-to-pdf" class="hover:text-white transition-colors">Text to PDF</a></li>
        <li><a href="/tools/pdf-to-text" class="hover:text-white transition-colors">PDF to Text</a></li>
        <li><a href="/tools/pdf-to-csv" class="hover:text-white transition-colors">PDF to CSV</a></li>
        <li><a href="/tools/pdf-to-html" class="hover:text-white transition-colors">PDF to HTML</a></li>
        <li><a href="/tools/pdf-to-excel" class="hover:text-white transition-colors">PDF to Excel</a></li>
      </ul>
    </div>

    <!-- Image Tools Column -->
    <div>
      <div class="font-mono text-xs uppercase tracking-wider text-white mb-4 font-bold">Image Tools</div>
      <ul class="space-y-2.5 text-xs text-[#8f9bb3]">
        <li><a href="/tools/image-to-pdf" class="hover:text-white transition-colors">Image to PDF</a></li>
        <li><a href="/tools/text-to-image" class="hover:text-white transition-colors">Text to Image</a></li>
      </ul>
      <div class="font-mono text-xs uppercase tracking-wider text-white mt-6 mb-4 font-bold">Document Converter</div>
      <ul class="space-y-2.5 text-xs text-[#8f9bb3]">
        <li><a href="/tools/jpg-to-word" class="hover:text-white transition-colors">JPG to Word</a></li>
        <li><a href="/tools/text-to-word" class="hover:text-white transition-colors">Text to Word</a></li>
        <li><a href="/tools/excel-to-csv" class="hover:text-white transition-colors">Excel to CSV</a></li>
        <li><a href="/tools/word-to-excel" class="hover:text-white transition-colors">Word to Excel</a></li>
        <li><a href="/tools/word-to-jpg" class="hover:text-white transition-colors">Word to JPG</a></li>
        <li><a href="/tools/csv-to-excel" class="hover:text-white transition-colors">CSV to Excel</a></li>
        <li><a href="/tools/excel-to-pdf" class="hover:text-white transition-colors">Excel to PDF</a></li>
      </ul>
    </div>

    <!-- Legal Column -->
    <div>
      <div class="font-mono text-xs uppercase tracking-wider text-white mb-4 font-bold">Legal</div>
      <ul class="space-y-2.5 text-xs text-[#8f9bb3]">
        <li><a href="/privacy-policy" class="hover:text-white transition-colors">Privacy Policy</a></li>
        <li><a href="/terms" class="hover:text-white transition-colors">Terms & Conditions</a></li>
        <li><a href="/cookies" class="hover:text-white transition-colors">Cookies</a></li>
      </ul>
    </div>

    <!-- Company Column -->
    <div>
      <div class="font-mono text-xs uppercase tracking-wider text-white mb-4 font-bold">Company</div>
      <ul class="space-y-2.5 text-xs text-[#8f9bb3]">
        <li><a href="/about" class="hover:text-white transition-colors">About us</a></li>
        <li><a href="/contact" class="hover:text-white transition-colors">Contact us</a></li>
      </ul>
    </div>

  </div>
</footer>
