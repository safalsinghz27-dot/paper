# Environment Variables Configuration
# Copy this file to .env.local and fill in your values

# Google Analytics
PUBLIC_GA_ID=G_XXXXXXXXXX

# Sentry Error Tracking (Optional)
PUBLIC_SENTRY_DSN=

# API Configuration
PUBLIC_API_URL=https://api.paperepair.com
PUBLIC_API_TIMEOUT=30000

# Feature Flags
PUBLIC_ENABLE_ANALYTICS=true
PUBLIC_ENABLE_ERROR_REPORTING=true
PUBLIC_ENABLE_PERFORMANCE_MONITORING=true

# Support & Contact
PUBLIC_SUPPORT_EMAIL=support@paperepair.com
PUBLIC_SECURITY_EMAIL=security@paperepair.com
PUBLIC_FEEDBACK_EMAIL=feedback@paperepair.com
